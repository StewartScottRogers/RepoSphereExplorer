import { ScrollView, Palette, TextEdit } from "std-widgets.slint";

// Every colour comes from the system palette, so the window follows the
// Windows light/dark setting and its accent colour instead of being dark
// whatever the user chose. `Palette` reports the scheme the platform is
// using; the derived shades below are the handful of tones the panes need
// on top of it, expressed as offsets from the system's own so they stay
// right in both schemes.
export global Theme {
    out property <bool> dark: Palette.color-scheme == ColorScheme.dark;
    // Panels sitting on the window background: toolbar, column header, menus.
    out property <brush> panel: dark
        ? Palette.background.brighter(0.35)
        : Palette.background.darker(0.06);
    // A sunken field, such as the address bar.
    out property <brush> field: dark
        ? Palette.background.darker(0.25)
        : Palette.background.brighter(0.6);
    // Hover feedback on a menu item or toolbar button.
    out property <brush> hover: dark
        ? Palette.background.brighter(0.7)
        : Palette.background.darker(0.12);
    // Secondary text: the size, type and date columns.
    out property <brush> dim-text: Palette.foreground.transparentize(0.35);
    // Text on a pane heading that is not focused.
    out property <brush> heading-text: Palette.foreground.transparentize(0.2);
    out property <brush> border: Palette.border;
    // A group divider inside a bar sits on the panel colour, where the
    // ordinary border is too faint to register at a glance. This is the
    // same rule a Windows toolbar draws between its groups.
    out property <brush> divider: dark
        ? Palette.background.brighter(1.1)
        : Palette.background.darker(0.30);
    // The edge under a bar, separating chrome from content.
    out property <brush> chrome-edge: dark
        ? Palette.background.brighter(0.9)
        : Palette.background.darker(0.22);
    // A button being pressed, which should not look like one being hovered.
    out property <brush> pressed: dark
        ? Palette.background.brighter(1.0)
        : Palette.background.darker(0.20);
    out property <brush> accent: Palette.accent-background;
    out property <brush> on-accent: Palette.accent-foreground;

    // Syntax colours, one pair per class, chosen for the two schemes
    // rather than derived from the palette: a hue that reads as "string"
    // has to stay that hue, and shifting it with the accent colour would
    // make the same file look like a different language on two machines.
    //
    // class | light      | dark       | why
    // ------|------------|------------|---------------------------------
    //     1 | #0000c0    | #569cd6    | keyword: the blue every editor uses
    //     2 | #267f99    | #4ec9b0    | type: teal, near the keyword but not it
    //     3 | #795e26    | #dcdcaa    | function: warm, so a call stands out
    //     4 | #a31515    | #ce9178    | string: red-brown, the oldest convention
    //     5 | #098658    | #b5cea8    | number: green, quiet
    //     6 | #008000    | #6a9955    | comment: green, and the one to look past
    //     7 | dimmed     | dimmed     | punctuation: present, not competing
    //
    // The light column is Visual Studio's default, the dark column is
    // Visual Studio Code's dark+. Both are what a reader has already
    // spent years looking at, which is the whole argument for them.
    public pure function syntax-colour(class: int) -> brush {
        if (class == 1) { return dark ? #569cd6 : #0000c0; }
        if (class == 2) { return dark ? #4ec9b0 : #267f99; }
        if (class == 3) { return dark ? #dcdcaa : #795e26; }
        if (class == 4) { return dark ? #ce9178 : #a31515; }
        if (class == 5) { return dark ? #b5cea8 : #098658; }
        if (class == 6) { return dark ? #6a9955 : #008000; }
        if (class == 7) { return dim-text; }
        return Palette.foreground;
    }
}

/// One coloured run of a line in the Text view. `class` is
/// `plugin_api::Class` as a number, mapped to a colour by
/// `Theme.syntax-colour`.
export struct ColouredRun {
    text: string,
    class: int,
}

/// One row of the navigation tree. Mirrors `app::FolderRow`.
export struct FolderRow {
    icon: image,
    name: string,
    depth: int,
    expandable: bool,
    expanded: bool,
}

component Pane inherits Rectangle {
    in property <string> title;
    in property <bool> focused;
    in property <[FolderRow]> rows;
    in property <int> selected;
    // The click carries where it landed, because the chevron and the name
    // do different things and only Rust knows which is which - see
    // `app::chevron_hit`.
    callback row-clicked(int, length);
    callback row-double-clicked(int);

    // The scroll offset, and how much of the listing fits. Both surfaced so
    // the front end can put the selected row on screen: the rule for that is
    // in Rust (`scroll_offset_for`), because a `changed selected` handler in
    // here cannot be exercised without an event loop, and untestable
    // behaviour in this file has cost this project three defects already.
    in-out property <length> scroll-y;
    out property <length> viewport-height: scroll.visible-height;

    // A per-row `for`-loop generating `TouchArea` instances leaves every
    // instance but the first permanently unresponsive to real mouse input
    // under Slint 1.17.1 (matches upstream issue #6836). So there is one
    // overlay `TouchArea` for the whole pane, and it derives the row from
    // `mouse-y` and the chevron from `mouse-x`. Repeated `Rectangle`s are
    // fine, and are what the contents pane already draws.
    property <length> row-height: 20px;

    // File Explorer's navigation pane geometry. These have to agree with
    // `app::FOLDER_PADDING`, `FOLDER_INDENT` and `FOLDER_CHEVRON`, which are
    // what decide whether a click landed on a chevron.
    property <length> pad: 4px;
    property <length> indent: 16px;
    property <length> chevron: 16px;

    // The row under the pointer, or -1 when the pointer is elsewhere.
    property <int> hovered: click-area.has-hover && rows.length > 0
        ? clamp(floor(click-area.mouse-y / row-height), 0, rows.length - 1)
        : -1;

    border-width: 1px;
    border-color: focused ? Theme.accent : Theme.border;

    VerticalLayout {
        Text {
            text: title;
            font-weight: 700;
            color: focused ? Theme.accent : Theme.heading-text;
            height: 22px;
            horizontal-alignment: center;
        }
        scroll := ScrollView {
            viewport-y <=> root.scroll-y;
            // `ScrollView` vertically centers a child shorter than its
            // viewport rather than pinning it to the top, so the row
            // container needs an explicit top-aligned layout around it.
            VerticalLayout {
                alignment: start;
                Rectangle {
                    height: max(rows.length * row-height, 1px);

                    for row[i] in rows: tree-row := Rectangle {
                        y: i * row-height;
                        height: row-height;
                        width: 100%;
                        // Selected wins over hovered, as it does in
                        // Explorer: the pointer passing over the selection
                        // must not make it look unselected.
                        background: i == selected
                            ? Theme.accent
                            : (i == hovered ? Theme.hover : transparent);
                        // Named and labelled so a test can ask which rows
                        // the pane is showing, the same way the contents
                        // pane's rows can be asked.
                        accessible-role: text;
                        accessible-label: row.name;

                        HorizontalLayout {
                            padding-left: pad + row.depth * indent;
                            padding-right: 4px;

                            // The chevron column is there whether or not the
                            // row has a chevron, so every name at a given
                            // depth starts at the same place.
                            Rectangle {
                                width: chevron;
                                horizontal-stretch: 0;
                                if row.expandable: Path {
                                    width: 7px;
                                    height: 9px;
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                    viewbox-width: 7;
                                    viewbox-height: 9;
                                    stroke: i == selected ? Theme.on-accent : Theme.dim-text;
                                    stroke-width: 1.4px;
                                    commands: row.expanded
                                        ? "M 0.5 2.5 L 3.5 6 L 6.5 2.5"
                                        : "M 2 1 L 5.5 4.5 L 2 8";
                                }
                            }
                            // Named so a test can measure where it lands:
                            // the indent drawn here and `app::FOLDER_INDENT`,
                            // which decides what a click hit, have to be the
                            // same number.
                            folder-icon := Image {
                                source: row.icon;
                                width: 16px;
                                height: 16px;
                                image-fit: contain;
                                horizontal-stretch: 0;
                            }
                            Rectangle {
                                width: 5px;
                                horizontal-stretch: 0;
                            }
                            Text {
                                text: row.name;
                                color: i == selected ? Theme.on-accent : Palette.foreground;
                                vertical-alignment: center;
                                overflow: elide;
                                horizontal-stretch: 1;
                                min-width: 24px;
                            }
                        }
                    }

                    click-area := TouchArea {
                        width: 100%;
                        height: 100%;
                        clicked => {
                            if (rows.length > 0) {
                                row-clicked(
                                    clamp(floor(click-area.mouse-y / row-height), 0, rows.length - 1),
                                    click-area.mouse-x);
                            }
                        }
                        double-clicked => {
                            if (rows.length > 0) {
                                row-double-clicked(clamp(floor(click-area.mouse-y / row-height), 0, rows.length - 1));
                            }
                        }
                    }
                }
            }
        }
    }
}

export struct ContentRow {
    icon: image,
    name: string,
    size: string,
    kind: string,
    modified: string,
    // A working copy's branch, "detached" when it is on none; empty for any
    // other row.
    branch: string,
    // Beside the branch: a dot for uncommitted changes to tracked files, an
    // ellipsis until that is known, "?" when it cannot be told, empty for
    // none.
    marker: string,
    // Whether this row is a source control working copy. The Repos Directory
    // is a workspace, so which of its folders are checkouts is the first
    // thing a reader is looking for.
    is-repository: bool,
    // Whether this row is part of the selection. With Ctrl and Shift in play
    // that is no longer "the one row whose index matches".
    selected: bool,
}

// One column heading in the contents pane's details view: clickable to sort,
// showing the direction arrow when it is the active column.
// A toolbar button: a square glyph button that greys out when it has nowhere
// to go, the way Explorer's back and forward arrows do.
component NavButton inherits Rectangle {
    in property <string> glyph;
    in property <bool> button-enabled: true;
    callback activated();

    width: 28px;
    background: !button-enabled
        ? transparent
        : (nav-touch.pressed
            ? Theme.pressed
            : (nav-touch.has-hover ? Theme.hover : transparent));
    border-radius: 3px;
    border-width: button-enabled && nav-touch.has-hover ? 1px : 0px;
    border-color: Theme.divider;

    Text {
        text: glyph;
        color: button-enabled ? Palette.foreground : Theme.dim-text;
        horizontal-alignment: center;
        vertical-alignment: center;
        width: 100%;
        height: 100%;
    }

    nav-touch := TouchArea {
        width: 100%;
        height: 100%;
        enabled: button-enabled;
        clicked => { activated(); }
    }
}

// One segment of the address bar's path, clickable to jump to that folder.
component Crumb inherits Rectangle {
    in property <string> label;
    in property <bool> last;
    callback activated();

    background: crumb-touch.has-hover && !last ? Theme.hover : transparent;
    border-radius: 3px;

    HorizontalLayout {
        padding-left: 6px;
        padding-right: 6px;
        Text {
            text: label;
            color: last ? Theme.accent : Palette.foreground;
            vertical-alignment: center;
        }
    }

    crumb-touch := TouchArea {
        width: 100%;
        height: 100%;
        enabled: !last;
        clicked => { activated(); }
    }
}

component ColumnHeader inherits Rectangle {
    in property <string> label;
    in property <bool> active;
    in property <bool> ascending;
    in property <bool> align-right;
    callback activated();

    background: heading-touch.has-hover ? Theme.hover : transparent;

    HorizontalLayout {
        padding-left: 4px;
        padding-right: 4px;
        alignment: align-right ? end : start;
        spacing: 2px;
        Text {
            text: label;
            color: active ? Theme.accent : Theme.heading-text;
            vertical-alignment: center;
            overflow: elide;
        }
        Text {
            // U+25B2 / U+25BC. The smaller U+25B4 / U+25BE render as tofu
            // in the default font here.
            text: active ? (ascending ? "\u{25B2}" : "\u{25BC}") : "";
            color: Theme.accent;
            vertical-alignment: center;
        }
    }

    heading-touch := TouchArea {
        width: 100%;
        height: 100%;
        clicked => { activated(); }
    }
}

// A draggable divider between two panes. Reports how far it was dragged so
// the window can widen one pane and narrow the next.
component Splitter inherits Rectangle {
    callback dragged(length);

    width: 5px;
    background: split-touch.has-hover || split-touch.pressed ? Theme.accent : Theme.border;

    split-touch := TouchArea {
        width: 100%;
        height: 100%;
        mouse-cursor: ew-resize;
        moved => {
            if (self.pressed) {
                dragged(self.mouse-x - self.pressed-x);
            }
        }
    }
}

// One title in the menu bar. Opening a menu is a property change rather
// than a `PopupWindow`, so the dropdown is an ordinary element of the window
// that can be sized, positioned and clicked like any other.
component MenuTitle inherits Rectangle {
    in property <string> label;
    in property <bool> open;
    callback activated();

    width: title-text.preferred-width + 20px;
    background: open ? Theme.accent : (title-touch.has-hover ? Theme.hover : transparent);

    title-text := Text {
        text: label;
        color: open ? Theme.on-accent : Palette.foreground;
        horizontal-alignment: center;
        vertical-alignment: center;
        width: 100%;
        height: 100%;
    }

    title-touch := TouchArea {
        width: 100%;
        height: 100%;
        clicked => { activated(); }
    }
}

// A labelled button on the command bar, greyed out when its command has
// nothing to act on.
component CommandButton inherits Rectangle {
    in property <string> label;
    in property <bool> button-enabled: true;
    callback activated();

    width: command-text.preferred-width + 20px;
    border-radius: 3px;
    // Three states, told apart: at rest, hovered (a fill and an edge, so the
    // button has a shape), and pressed (a deeper fill). A press that looks
    // like a hover is a button that never confirms it was clicked.
    background: !button-enabled
        ? transparent
        : (command-touch.pressed
            ? Theme.pressed
            : (command-touch.has-hover ? Theme.hover : transparent));
    border-width: button-enabled && command-touch.has-hover ? 1px : 0px;
    border-color: Theme.divider;

    command-text := Text {
        text: label;
        // Reported so a test can ask what the toolbars are offering,
        // which is the only way to check a row of buttons from outside.
        accessible-role: text;
        accessible-label: label;
        color: button-enabled ? Palette.foreground : Theme.dim-text;
        horizontal-alignment: center;
        vertical-alignment: center;
        width: 100%;
        height: 100%;
    }

    command-touch := TouchArea {
        width: 100%;
        height: 100%;
        enabled: button-enabled;
        clicked => { activated(); }
    }
}

// The hairline that ends a bar, so the chrome reads as chrome and the panes
// start where it stops. Its own component because a Windows title area is
// several strips, each with an edge, and an element id has to be unique
// inside the component that holds it.
component ChromeEdge inherits Rectangle {
    // Positioned by whoever places it: a component cannot reach its parent,
    // and the bars know their own height.
    height: 1px;
    rule := Rectangle {
        width: 100%;
        height: 1px;
        background: Theme.chrome-edge;
    }
}

// The rule between two groups of commands, with the room around it that
// makes the grouping read as grouping. Named so a test can find it and
// check the divisions are there and visible.
component CommandSeparator inherits Rectangle {
    width: 15px;
    accessible-role: none;
    rule := Rectangle {
        width: 1px;
        height: 70%;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        background: Theme.divider;
    }
}

component ContextMenuItem inherits Rectangle {
    in property <string> label;
    in property <string> shortcut;
    in property <bool> item-enabled: true;
    in property <length> item-height;
    callback activated();

    height: item-height;
    background: touch.has-hover && item-enabled ? Theme.accent : transparent;
    // Named for assistive technology, and so a test can find the item by
    // the label the user reads rather than by its position in the menu.
    accessible-role: button;
    accessible-label: label;
    accessible-enabled: item-enabled;

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 16px;
        Text {
            text: label;
            color: item-enabled ? Palette.foreground : Theme.dim-text;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
        Text {
            text: shortcut;
            color: Theme.dim-text;
            vertical-alignment: center;
            horizontal-stretch: 0;
        }
    }

    touch := TouchArea {
        width: 100%;
        height: 100%;
        // Always enabled, so a greyed item swallows the press rather than
        // letting it through. A disabled TouchArea is transparent to the
        // pointer, and the row menu sits directly over the Contents
        // pane's own overlay area - so pressing a greyed item selected
        // whatever row happened to be behind it.
        clicked => {
            if (item-enabled) {
                activated();
            }
        }
    }
}

// The contents pane's own variant of `Pane`, with a right-click context menu
// added on top of the same row rendering. Uses the same Text-row / single
// overlay TouchArea workaround as `Pane` (see its comment) for the Slint
// for-loop TouchArea bug - a per-row TouchArea here would also lose right-
// click delivery on every row past the first, not just left-click.
component ContentsPane inherits Rectangle {
    in property <string> title;
    in property <bool> focused;
    in property <[ContentRow]> rows;
    in property <int> selected;
    // Which column the list is sorted by, and which way, so the header can
    // show the indicator Explorer shows.
    in property <int> sort-column;
    // While a search's results fill the pane, its columns hold a result's
    // repository and folder rather than a size, type and date.
    in property <bool> showing-found;
    in property <bool> sort-ascending;
    callback sort-requested(int);
    // Whether the selected row previewed as an archive; Extract is greyed
    // out otherwise, since extracting anything else only ever errors.
    in property <bool> extract-enabled;
    // The prompt a pending operation is waiting on, drawn over the row it
    // applies to. Without it the only sign that a menu action did anything
    // is one line at the very bottom of the window.
    in property <string> prompt-text;
    in property <int> prompt-row;
    in property <bool> prompt-editable;
    callback row-clicked(int);
    callback row-ctrl-clicked(int);
    callback row-shift-clicked(int);
    // A rubber-band drag, reported once on release as the row range it
    // covered.
    callback rows-marqueed(int, int);
    callback row-double-clicked(int);
    callback open-requested();
    callback rename-requested();
    in property <bool> can-open;
    // Where the selected repository's web page is hosted, or empty when it
    // has none to open: a plain folder, a file, a checkout with no remote.
    in property <string> web-provider;
    callback open-web-requested();
    // Duplicating a file under a new name, which is what the "Copy to..."
    // item does. Distinct from the clipboard's Copy, which is what the
    // Ctrl+C beside that item means.
    callback copy-requested();
    callback clipboard-copy-requested();
    callback delete-requested();
    callback extract-requested();
    callback new-folder-requested();
    callback new-file-requested();

    property <length> row-height: 20px;
    // Where the last right-click landed, which both popups place themselves
    // at: a `PopupWindow` cannot be positioned from its enclosing component,
    // so it has to read the coordinates out of a property instead.
    property <length> menu-x;
    property <length> menu-y;
    // A `PopupWindow` with no size of its own is laid out 0x0. Its contents
    // still draw - nothing clips them - but hit-testing is bounded by the
    // popup, so every item in it is unclickable. Both menus therefore state
    // their size, which means stating the item height and count here.
    property <length> menu-width: 150px;
    property <length> menu-item-height: 24px;
    // Which context menu is open: -1 none, 0 on a row, 1 on empty space.
    property <int> open-context: -1;
    // The rubber band, while one is being dragged. `band-from` is where the
    // press landed and `band-to` follows the pointer; a drag shorter than a
    // row is treated as a click, not a marquee.
    property <bool> banding;
    property <length> band-from;
    property <length> band-to;
    // Details-view columns. The three trailing ones are fixed and Name
    // stretches into the rest, in both the header and every row, so the two
    // line up without either deriving a width from the pane's own width -
    // which would close a layout binding loop.
    property <length> size-column: 80px;
    property <length> kind-column: 90px;
    property <length> modified-column: 118px;
    property <length> header-height: 20px;

    // As `Pane`: the offset and the visible height, so the front end can
    // scroll the selected row into view from Rust.
    in-out property <length> scroll-y;
    out property <length> viewport-height: scroll.visible-height;

    border-width: 1px;
    border-color: focused ? Theme.accent : Theme.border;

    VerticalLayout {
        Text {
            text: title;
            font-weight: 700;
            color: focused ? Theme.accent : Theme.heading-text;
            height: 22px;
            horizontal-alignment: center;
        }
        Rectangle {
            height: header-height;
            background: Theme.panel;
            HorizontalLayout {
                padding-left: 4px;
                padding-right: 4px;
                ColumnHeader {
                    horizontal-stretch: 1;
                    min-width: 40px;
                    label: "Name";
                    active: sort-column == 0;
                    ascending: sort-ascending;
                    activated => { sort-requested(0); }
                }
                ColumnHeader {
                    width: size-column;
                    horizontal-stretch: 0;
                    label: showing-found ? "" : "Size";
                    align-right: true;
                    active: sort-column == 1;
                    ascending: sort-ascending;
                    activated => { sort-requested(1); }
                }
                ColumnHeader {
                    width: kind-column;
                    horizontal-stretch: 0;
                    align-right: true;
                    label: showing-found ? "Repository" : "Type";
                    active: sort-column == 2;
                    ascending: sort-ascending;
                    activated => { sort-requested(2); }
                }
                ColumnHeader {
                    width: modified-column;
                    horizontal-stretch: 0;
                    align-right: true;
                    label: showing-found ? "" : "Modified";
                    active: sort-column == 3;
                    ascending: sort-ascending;
                    activated => { sort-requested(3); }
                }
            }
        }
        scroll := ScrollView {
            viewport-y <=> root.scroll-y;
            // The same top-aligned layout the folders pane has, and needed
            // for the same reason: a `ScrollView` lays a bare child out at
            // its own height rather than the child's, so the listing was
            // 452px tall however many rows it held. There was nothing to
            // scroll, and the offset Rust writes to bring the selected row
            // into view was back to zero by the next frame.
            //
            // The rows are drawn at `i * row-height` whether or not the
            // viewport is tall enough to hold them, so the pane looked
            // right until the selection went past the fold - and then it
            // stopped following, with no row highlighted anywhere.
            VerticalLayout {
                alignment: start;
                body := Rectangle {
                    width: 100%;
                    // The second term keeps a short listing filling the pane,
                    // so a click below the last row still lands on the pane
                    // rather than falling through.
                    min-height: max(rows.length * row-height, root.height - 22px - header-height);

                    for row[i] in rows: Rectangle {
                        y: i * row-height;
                        height: row.selected ? row-height : 0px;
                        width: 100%;
                        background: Theme.accent;
                    }

                    for row[i] in rows: listing-row := Rectangle {
                        y: i * row-height;
                        height: row-height;
                        width: 100%;
                        // Named so a test can ask which rows are on screen: the
                        // element search returns the visible ones, which is
                        // exactly the question "did the pane scroll far enough,
                        // and no further".
                        accessible-role: text;
                        accessible-label: row.name;
                        HorizontalLayout {
                            padding-left: 4px;
                            padding-right: 4px;
                            HorizontalLayout {
                                horizontal-stretch: 1;
                                spacing: 5px;
                                padding-top: 2px;
                                padding-bottom: 2px;
                                Image {
                                    source: row.icon;
                                    width: 16px;
                                    image-fit: contain;
                                    horizontal-stretch: 0;
                                }
                                Text {
                                    text: row.name;
                                    // A working copy is named in the accent
                                    // colour and in bold: distinguishable at a
                                    // glance from an ordinary folder, which
                                    // stays listed and stays plain.
                                    color: row.selected
                                        ? Theme.on-accent
                                        : (row.is-repository ? Theme.accent : Palette.foreground);
                                    font-weight: row.is-repository ? 700 : 400;
                                    overflow: elide;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                    min-width: 24px;
                                }
                                // The branch and its marker share the Name
                                // column rather than taking one of their own:
                                // the pane is narrow, and a fixed Branch
                                // column would cut every repository name to a
                                // few letters to leave room for a word most
                                // rows would repeat.
                                Text {
                                    text: row.branch;
                                    color: row.selected ? Theme.on-accent : Theme.dim-text;
                                    overflow: elide;
                                    vertical-alignment: center;
                                    horizontal-stretch: 0;
                                    max-width: 120px;
                                }
                                Text {
                                    text: row.marker;
                                    color: row.selected ? Theme.on-accent : Theme.accent;
                                    vertical-alignment: center;
                                    horizontal-stretch: 0;
                                }
                            }
                            Text {
                                text: row.size;
                                color: row.selected ? Theme.on-accent : Theme.dim-text;
                                width: size-column;
                                horizontal-alignment: right;
                                vertical-alignment: center;
                                horizontal-stretch: 0;
                            }
                            Text {
                                text: row.kind;
                                color: row.selected ? Theme.on-accent : Theme.dim-text;
                                width: kind-column;
                                overflow: elide;
                                horizontal-alignment: right;
                                vertical-alignment: center;
                                horizontal-stretch: 0;
                            }
                            Text {
                                text: row.modified;
                                color: row.selected ? Theme.on-accent : Theme.dim-text;
                                width: modified-column;
                                overflow: elide;
                                horizontal-alignment: right;
                                vertical-alignment: center;
                                horizontal-stretch: 0;
                            }
                        }
                    }

                    if prompt-row >= 0: Rectangle {
                        y: prompt-row * row-height;
                        height: row-height;
                        width: 100%;
                        background: Theme.field;
                        border-width: 1px;
                        border-color: Theme.accent;
                        HorizontalLayout {
                            padding-left: 4px;
                            spacing: 2px;
                            alignment: start;
                            Text {
                                text: prompt-text;
                                color: Theme.accent;
                                vertical-alignment: center;
                            }
                            // A caret, so a text prompt reads as one waiting for
                            // typing rather than as a label.
                            Rectangle {
                                width: prompt-editable ? 1px : 0px;
                                background: Theme.accent;
                                y: 3px;
                                height: row-height - 6px;
                            }
                            Text {
                                text: prompt-editable ? "  (Enter / Esc)" : "";
                                color: Theme.dim-text;
                                vertical-alignment: center;
                            }
                        }
                    }

                    if banding: Rectangle {
                        y: min(band-from, band-to);
                        height: abs(band-to - band-from);
                        width: 100%;
                        background: Theme.accent.transparentize(0.75);
                        border-width: 1px;
                        border-color: Theme.accent;
                    }

                    click-area := TouchArea {
                        width: 100%;
                        height: 100%;
                        moved => {
                            if (click-area.pressed) {
                                band-to = click-area.mouse-y;
                                // A press that has not travelled a row's height
                                // is still a click; only past that is it a drag.
                                if (abs(band-to - band-from) >= row-height) {
                                    banding = true;
                                }
                            }
                        }
                        double-clicked => {
                            if (rows.length > 0 && click-area.mouse-y < rows.length * row-height) {
                                row-double-clicked(clamp(floor(click-area.mouse-y / row-height), 0, rows.length - 1));
                            }
                        }
                        pointer-event(event) => {
                            if (event.kind == PointerEventKind.down) {
                                // Any press dismisses an open context menu; the
                                // item's own handler runs first when the press
                                // landed on one.
                                open-context = -1;
                                band-from = click-area.mouse-y;
                                band-to = click-area.mouse-y;
                            }
                            if (event.kind == PointerEventKind.up && banding) {
                                banding = false;
                                if (rows.length > 0) {
                                    rows-marqueed(
                                        clamp(floor(min(band-from, band-to) / row-height), 0, rows.length - 1),
                                        clamp(floor(max(band-from, band-to) / row-height), 0, rows.length - 1));
                                }
                            }
                            if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left && !banding) {
                                if (rows.length > 0 && click-area.mouse-y < rows.length * row-height) {
                                    if (event.modifiers.control) {
                                        row-ctrl-clicked(clamp(floor(click-area.mouse-y / row-height), 0, rows.length - 1));
                                    } else if (event.modifiers.shift) {
                                        row-shift-clicked(clamp(floor(click-area.mouse-y / row-height), 0, rows.length - 1));
                                    } else {
                                        row-clicked(clamp(floor(click-area.mouse-y / row-height), 0, rows.length - 1));
                                    }
                                }
                            }
                            if (event.kind == PointerEventKind.down && event.button == PointerEventButton.right) {
                                if (rows.length > 0 && click-area.mouse-y < rows.length * row-height) {
                                    row-clicked(clamp(floor(click-area.mouse-y / row-height), 0, rows.length - 1));
                                    // Open at the pointer: a `PopupWindow` with no
                                    // placement of its own lands at the pane's
                                    // top-left corner, half over the folders pane.
                                    menu-x = click-area.mouse-x;
                                    menu-y = click-area.mouse-y;
                                    open-context = 0;
                                } else {
                                    menu-x = click-area.mouse-x;
                                    menu-y = click-area.mouse-y;
                                    open-context = 1;
                                }
                            }
                        }
                    }

                    // Each menu box takes its height from the items in it. They
                    // were sized by hand, as a count times the item height, and
                    // the counts drifted: the row menu held six items in a box
                    // for five, so Extract hung below its border, and the View
                    // menu drew two empty rows under its last item.
                    //
                    // The context menus are ordinary elements rather than
                    // `PopupWindow`s: a popup cannot be positioned from its
                    // enclosing component, has to be sized by hand or it is laid
                    // out 0x0 with its contents unhittable, and its default close
                    // policy eats the click that chooses an item. An element in
                    // the pane has none of those problems.
                    if open-context == 1: Rectangle {
                        x: menu-x;
                        y: menu-y;
                        width: menu-width;
                        height: empty-menu-items.preferred-height;
                        background: Theme.panel;
                        border-width: 1px;
                        border-color: Theme.border;
                        empty-menu-items := VerticalLayout {
                            ContextMenuItem {
                                label: "New Folder";
                                item-height: menu-item-height;
                                activated => { open-context = -1; new-folder-requested(); }
                            }
                            ContextMenuItem {
                                label: "New File";
                                item-height: menu-item-height;
                                activated => { open-context = -1; new-file-requested(); }
                            }
                        }
                    }

                    if open-context == 0: Rectangle {
                        x: menu-x;
                        y: menu-y;
                        width: menu-width;
                        height: row-menu-items.preferred-height;
                        background: Theme.panel;
                        border-width: 1px;
                        border-color: Theme.border;
                        row-menu-items := VerticalLayout {
                            ContextMenuItem {
                                label: "Open";
                                item-enabled: can-open;
                                item-height: menu-item-height;
                                activated => { open-context = -1; open-requested(); }
                            }
                            ContextMenuItem {
                                // Named for where it goes, so the reader knows
                                // before they click.
                                label: web-provider == "" ? "Open on the web" : "Open on " + web-provider;
                                item-enabled: web-provider != "";
                                item-height: menu-item-height;
                                activated => { open-context = -1; open-web-requested(); }
                            }
                            ContextMenuItem {
                                label: "Rename";
                                shortcut: "F2";
                                item-height: menu-item-height;
                                activated => { open-context = -1; rename-requested(); }
                            }
                            ContextMenuItem {
                                label: "Copy";
                                shortcut: "Ctrl+C";
                                item-height: menu-item-height;
                                activated => { open-context = -1; clipboard-copy-requested(); }
                            }
                            ContextMenuItem {
                                // The other Copy: duplicate this file here
                                // under a name you type. It carried the
                                // Ctrl+C label above until that shortcut
                                // turned out to mean something else.
                                label: "Copy to...";
                                item-height: menu-item-height;
                                activated => { open-context = -1; copy-requested(); }
                            }
                            ContextMenuItem {
                                label: "Delete";
                                shortcut: "Del";
                                item-height: menu-item-height;
                                activated => { open-context = -1; delete-requested(); }
                            }
                            ContextMenuItem {
                                label: "Extract";
                                item-height: menu-item-height;
                                item-enabled: extract-enabled;
                                activated => { open-context = -1; extract-requested(); }
                            }
                        }
                    }
                }
            }
        }
    }
}

// A monospace editing surface: coloured rows, a caret, a selection, and
// a keyboard.
//
// Every decision is in Rust - `gui::document` for what the caret does,
// `gui::editor` for what a key and a click mean. This draws what it is
// told and reports where a pointer landed, nothing else. That is the
// same split as `scroll_offset_for` and `chevron_hit`, and for the same
// reason: a rule written here cannot be exercised without an event loop.
//
// **Fixed-width, and not as a preference** (GUIDANCE.md §3.6). Slint
// offers no way to ask where character *n* of a string sits, so a caret
// can only be placed where the column and the pixel are related by
// arithmetic. `cell-width` is measured once from a run of the same font
// rather than guessed, and Rust is handed the same number so that a
// click and the caret cannot disagree.
component CodeEditor inherits Rectangle {
    in property <[[ColouredRun]]> lines;
    // Where the caret is, in rows and columns.
    in property <int> caret-line;
    in property <int> caret-column;
    // The selection, as two points. A start line of -1 means none.
    in property <int> selection-start-line: -1;
    in property <int> selection-start-column;
    in property <int> selection-end-line;
    in property <int> selection-end-column;
    in property <bool> focused;
    // How wide the widest line is, in columns, so the surface can scroll
    // sideways rather than wrap - a wrapped line of code puts its second
    // half under a column it has nothing to do with. Rust counts it;
    // asking Slint would close a binding loop through the rows' width.
    in property <int> longest-line;

    in-out property <length> scroll-y;
    out property <length> viewport-height: scroll.visible-height;
    out property <int> visible-rows: floor(scroll.visible-height / row-height);

    // One character's width, measured rather than assumed. Rust reads
    // this to turn a click into a column, so the two halves cannot drift.
    out property <length> cell-width: measure.preferred-width / 40;

    callback pressed(int, int);
    callback dragged(int, int);
    callback double-pressed(int, int);
    // The keystroke, verbatim, for Rust to make sense of. True when
    // the editor used it; false leaves it for the window behind.
    callback key(string, bool, bool) -> bool;

    property <length> row-height: 16px;
    property <length> gutter: 4px;
    property <string> face: "Consolas, Menlo, monospace";
    property <length> size: 12px;

    forward-focus: keys;

    // The surface takes the keyboard the moment it exists, not on the
    // first click. It is created when the editor opens, so this is that
    // moment - and without it a reader who opened the editor from the
    // Edit tab had their first keystrokes go to the window's own focus
    // scope, which is the Contents pane's type-ahead. From the outside:
    // the editor does not insert at the caret.
    init => { keys.focus(); }

    // Off-screen, and the only thing that knows how wide a character is.
    // Forty of them rather than one, so that rounding in the font's
    // metrics is divided away rather than multiplied up.
    measure := Text {
        text: "0000000000000000000000000000000000000000";
        font-family: face;
        font-size: size;
        visible: false;
        x: -10000px;
    }

    keys := FocusScope {
        key-pressed(event) => {
            // Accepting every key was simple and wrong: Escape, Ctrl+S
            // and F5 have no meaning down here, so they died in this
            // handler and a reader editing a file had no keyboard way
            // to save it or to put it back. A rejected key goes on to
            // the window's own scope, which knows what to do with it.
            return key(event.text, event.modifiers.shift, event.modifiers.control)
                ? accept : reject;
        }
    }

    scroll := ScrollView {
        viewport-y <=> root.scroll-y;
        VerticalLayout {
            alignment: start;
            body := Rectangle {
                width: max(root.width, longest-line * cell-width + 2 * gutter);
                height: max(lines.length * row-height, root.height);

                // The selection, as three rectangles: the tail of the
                // first line, every whole line between, and the head of
                // the last. One rectangle cannot do it, and one per line
                // would be a rectangle per line of the document.
                if selection-start-line >= 0: band-head := Rectangle {
                    x: gutter + selection-start-column * cell-width;
                    y: selection-start-line * row-height;
                    width: selection-start-line == selection-end-line
                        ? (selection-end-column - selection-start-column) * cell-width
                        : parent.width - self.x;
                    height: row-height;
                    background: Theme.accent.transparentize(0.6);
                }
                if selection-start-line >= 0 && selection-end-line > selection-start-line + 1: band-middle := Rectangle {
                    x: gutter;
                    y: (selection-start-line + 1) * row-height;
                    width: parent.width - gutter;
                    height: (selection-end-line - selection-start-line - 1) * row-height;
                    background: Theme.accent.transparentize(0.6);
                }
                if selection-start-line >= 0 && selection-end-line > selection-start-line: band-tail := Rectangle {
                    x: gutter;
                    y: selection-end-line * row-height;
                    width: selection-end-column * cell-width;
                    height: row-height;
                    background: Theme.accent.transparentize(0.6);
                }

                for line[row] in lines: editor-row := Rectangle {
                    y: row * row-height;
                    height: row-height;
                    width: 100%;
                    HorizontalLayout {
                        alignment: start;
                        padding-left: gutter;
                        for run in line: editor-run := Text {
                            text: run.text;
                            color: Theme.syntax-colour(run.class);
                            font-family: face;
                            font-size: size;
                            vertical-alignment: center;
                            accessible-role: text;
                            accessible-label: run.text;
                        }
                    }
                }

                // Named so a test can ask where it is, which is the one
                // thing about this surface that cannot be checked by
                // reading the code.
                caret := Rectangle {
                    x: gutter + caret-column * cell-width;
                    y: caret-line * row-height;
                    width: 1px;
                    height: row-height;
                    background: focused ? Palette.foreground : transparent;
                }

                // One touch area for the whole surface. Slint 1.17.1
                // leaves every per-row `TouchArea` but the first
                // unresponsive, which the folders and contents panes both
                // already work around.
                surface := TouchArea {
                    width: 100%;
                    height: 100%;
                    clicked => {
                        keys.focus();
                        pressed(row-at(surface.mouse-y), column-at(surface.mouse-x));
                    }
                    double-clicked => {
                        double-pressed(row-at(surface.mouse-y), column-at(surface.mouse-x));
                    }
                    moved => {
                        if (surface.pressed) {
                            dragged(row-at(surface.mouse-y), column-at(surface.mouse-x));
                        }
                    }
                }
            }
        }
    }

    // The exact inverse of where the caret is drawn: the caret for
    // column n sits at `gutter + n * cell-width`, so a click there gives
    // back n. Rounding rather than flooring because a click in the
    // right-hand half of a character belongs to the boundary after it,
    // which is where every editor puts the caret.
    public pure function column-at(x: length) -> int {
        max(0, round((x - gutter) / cell-width))
    }
    pure function row-at(y: length) -> int {
        clamp(floor(y / row-height), 0, max(lines.length - 1, 0))
    }

}


/// A window holding nothing but the editor, so #479 can be driven before
/// #480 puts it in the File pane. Deleted by that work order, which is
/// what makes it a harness rather than a second front end.
export component CodeEditorHarness inherits Window {
    in property <[[ColouredRun]]> lines;
    in property <int> caret-line;
    in property <int> caret-column;
    in property <int> selection-start-line: -1;
    in property <int> selection-start-column;
    in property <int> selection-end-line;
    in property <int> selection-end-column;
    in property <int> longest-line;
    in-out property <length> scroll-y <=> editor.scroll-y;
    out property <length> cell-width <=> editor.cell-width;
    out property <int> visible-rows <=> editor.visible-rows;
    callback pressed(int, int);
    callback key(string, bool, bool) -> bool;

    width: 600px;
    height: 320px;

    // The surface is the only thing in this window, so it has the
    // keyboard from the start rather than waiting to be clicked.
    init => { editor.focus(); }

    public pure function column-at(x: length) -> int {
        editor.column-at(x)
    }

    editor := CodeEditor {
        width: 100%;
        height: 100%;
        focused: true;
        lines: root.lines;
        caret-line: root.caret-line;
        caret-column: root.caret-column;
        selection-start-line: root.selection-start-line;
        selection-start-column: root.selection-start-column;
        selection-end-line: root.selection-end-line;
        selection-end-column: root.selection-end-column;
        longest-line: root.longest-line;
        pressed(line, column) => { root.pressed(line, column); }
        key(text, shift, control) => { return root.key(text, shift, control); }
    }
}

export component MainWindow inherits Window {
    title: "Repos Explorer";
    // The window icon: the title bar, the taskbar and Alt+Tab. The same
    // drawing the Windows binaries carry as a resource, so a window and a
    // shortcut to it show one picture.
    //
    // Declared here rather than handed to the window from Rust. An image a
    // running program builds carries no cache key, and Slint's window adapter
    // applies an icon only when its key differs from the one it is already
    // holding - so an icon set at run time is compared against the empty one,
    // found equal, and silently dropped. A `@image-url` is embedded at build
    // time and does have a key.
    //
    // Named, rather than bound straight to `icon`, so a test can ask the
    // window what it was given: the `icon` of a `Window` is not readable
    // from the generated Rust.
    out property <image> window-icon: @image-url("../../../assets/RepoSphereExplorer.svg");
    icon: root.window-icon;
    preferred-width: 1000px;
    preferred-height: 600px;
    background: Palette.background;
    // Windows' UI font. Slint falls back to the platform default wherever
    // it is not installed, so this costs nothing on other systems.
    default-font-family: "Segoe UI";

    in property <[FolderRow]> folder-rows;
    in property <int> folder-selected;
    in property <[ContentRow]> content-rows;
    in property <int> content-selected;
    in property <string> file-text;
    // The views the previewed type offers, and which one is showing. A type
    // offering one view gets no switcher, so it looks as it always did.
    in property <[string]> file-views;
    in property <int> file-view-index;
    // Tab metrics, shared by what is drawn and what a click is mapped
    // through, so the two cannot disagree.
    // Tabs share the strip rather than taking a fixed width each. At
    // 80px apiece a third tab fell off the right-hand edge of a
    // default-width File pane - so #495's Edit tab, the only sign the
    // pane gives that an editor exists, was invisible until somebody
    // widened the pane.
    private property <length> tab-w: file-tabs.length > 0
        ? file-pane.width / file-tabs.length
        : 80px;
    private property <length> tab-h: 24px;
    callback file-view-selected(int);
    // The strip above the File pane: the plugin's views and then the way
    // in to the editor. Built in Rust so the pane does not have to know
    // which is which.
    in property <[string]> file-tabs;
    in property <int> file-tab-index;
    callback file-tab-selected(int);
    // The editor's own commands, shown in the File pane while it is
    // open. The window's toolbar is about managing files, which is not
    // where anybody looks while typing into one.
    in property <bool> edit-modified;
    in property <bool> edit-can-undo;
    in property <bool> edit-can-redo;
    in property <bool> edit-has-selection;
    in property <int> edit-line;
    in property <int> edit-column;
    callback edit-undo-requested();
    callback edit-redo-requested();
    callback edit-cut-requested();
    callback edit-copy-requested();
    callback edit-paste-requested();
    // A picture for the previewed file, when its type is one.
    in property <image> file-graphic;
    in property <bool> file-has-graphic;
    in property <string> status-text;
    in property <int> focus-pane;

    callback folder-row-clicked(int, length);
    callback folder-row-double-clicked(int);
    callback content-row-clicked(int);
    callback content-row-ctrl-clicked(int);
    callback content-row-shift-clicked(int);
    callback content-rows-marqueed(int, int);
    callback content-row-double-clicked(int);
    callback content-open-requested();
    callback content-rename-requested();
    callback content-copy-requested();
    callback content-delete-requested();
    callback content-extract-requested();
    callback cancel-requested();
    callback delete-requested();
    callback return-pressed();
    callback backspace-pressed();
    callback key-text(string);
    callback parent-requested();
    callback new-folder-requested();
    callback new-file-requested();
    callback selection-moved(int);
    // The same movements with Shift held: the range grows to where the
    // key would have moved, rather than the selection jumping there.
    callback selection-extended(int);
    callback edge-extended(int);
    callback pane-cycled(int);
    // Whether the selected contents row previewed as an archive.
    in property <bool> content-is-archive;
    // The prompt a pending operation is waiting on, and the row it applies to.
    in property <string> content-prompt-text;
    in property <int> content-prompt-row: -1;
    in property <bool> content-prompt-editable;
    // What the command bar and menus enable from.
    in property <bool> has-selection;
    in property <bool> can-paste;
    callback quit-requested();
    // File > Repos Directory...: settles where every launch opens.
    callback repos-root-requested();
    callback about-requested();
    // Which contents column is sorted on, and which way.
    in property <int> content-sort-column;
    in property <bool> content-sort-ascending;
    callback content-sort-requested(int);
    // Address bar and history navigation.
    in property <[string]> breadcrumbs;
    // The browsed folder as one string. Only for noticing that it changed;
    // what is drawn comes from `breadcrumbs`.
    in property <string> address-path;
    in property <bool> can-go-back;
    in property <bool> can-go-forward;
    in property <bool> can-go-up;
    // The address bar as a text field, while a path is being typed.
    in property <string> path-input;
    in property <bool> editing-path;
    in property <image> location-icon;
    // The file pane as an editor, for the types whose plugin can edit them.
    in property <bool> editing-file;
    // The Text view's lines, each split into coloured runs. Empty when
    // there is nothing to colour - the Preview is showing, the plugin
    // describes no language, or the file carries no text - and the plain
    // `Text` below is drawn instead.
    in property <[[ColouredRun]]> file-lines;
    in property <bool> can-edit;
    in property <bool> can-open;
    in property <string> web-provider;
    callback open-web-requested();
    in property <bool> showing-found;
    callback find-requested();
    in-out property <string> edit-text;
    // The coloured surface's half of the editor. `editing-in-colour` is
    // false for a file it cannot serve - see `editor::code_editor_suits`
    // - and the plain box below takes it instead.
    in property <bool> editing-in-colour;
    in property <[[ColouredRun]]> edit-lines;
    in property <int> edit-caret-line;
    in property <int> edit-caret-column;
    in property <int> edit-selection-start-line: -1;
    in property <int> edit-selection-start-column;
    in property <int> edit-selection-end-line;
    in property <int> edit-selection-end-column;
    in property <int> edit-longest-line;
    // How many rows a page up or down moves by: what the pane is showing,
    // rather than a number chosen here. Measured from the File pane
    // rather than from the editor inside it, because Slint cannot name
    // an element that sits inside an `if`. The 22px is the pane heading
    // above the editor; being a row out either way costs nothing.
    // The 22px is the pane heading; the 46px is the editor's own command
    // row and the caret readout below it, which sit between the heading
    // and the text. Without them a page moved three rows further than
    // the reader could see, every time.
    out property <int> edit-visible-rows:
        floor((file-pane.height - 22px - (editing-file ? 46px : 0px)) / 16px);
    // True when the editing surface used the key. A false one falls
    // through to the window's own scope; see `key-scope` below for the
    // short list that still means something while a file is open.
    callback edit-key(string, bool, bool) -> bool;
    callback edit-pressed(int, int);
    callback edit-requested();
    callback save-requested();
    callback path-edit-requested();
    // How much of a long path is shown. Explorer hides the middle behind a
    // menu; this keeps the tail, which is the part that says where you are,
    // and expands in place when asked.
    property <int> max-crumbs: 5;
    property <bool> crumbs-expanded: false;

    // Expanding is for the path in front of the reader, not for every path
    // afterwards. Nothing put this back, so one click on the ellipsis left
    // every folder for the rest of the session drawing its full path - and
    // a long one pushes the tail, the part that says where you are, off
    // the end of the bar.
    //
    // Watched on the path rather than on `breadcrumbs`, which `sync_ui`
    // rebuilds on every timer tick: that would collapse the bar a tenth of
    // a second after the reader expanded it.
    changed address-path => {
        crumbs-expanded = false;
    }
    property <int> first-crumb: crumbs-expanded || breadcrumbs.length <= max-crumbs
        ? 0
        : breadcrumbs.length - max-crumbs;
    callback back-requested();
    callback forward-requested();
    callback breadcrumb-requested(int);
    // Windows clipboard and list navigation keys.
    callback clipboard-copy-requested();
    callback clipboard-cut-requested();
    callback clipboard-paste-requested();
    callback refresh-requested();
    callback select-all-requested();
    callback undo-requested();
    // Pane widths, moved by the splitters between them. The file pane takes
    // whatever the other two leave.
    // `in-out` so the widths can be restored at startup and read back when
    // the window closes; the splitters move them in between.
    in-out property <length> folders-width: 240px;
    in-out property <length> contents-width: 470px;
    // Each pane's scroll offset, so the front end can bring the selected row
    // into view. Two-way: the user scrolls with the wheel and the scrollbar
    // too, and whatever they left it at is where the next adjustment starts.
    in-out property <length> folders-scroll-y;
    in-out property <length> content-scroll-y;
    // How much of each listing is on screen, which decides whether the
    // selected row needs bringing into view at all.
    out property <length> folders-viewport-height: folders-pane.viewport-height;
    out property <length> content-viewport-height: contents-pane.viewport-height;
    // Which menu is open: -1 none, then File, Edit, View, Help. A menu is a
    // property rather than a `PopupWindow` so it can be sized, placed and
    // clicked like any other element.
    property <int> open-menu: -1;
    property <length> menu-item-h: 24px;
    callback edge-requested(int);

    forward-focus: key-scope;

    // The editing surface takes the keyboard when it opens, and its
    // focus scope is destroyed when it closes - leaving Slint's focus on
    // an item that no longer exists and every key after it delivered to
    // nobody. The whole window's keyboard was dead after a save or a
    // close until the window was deactivated and brought back.
    changed editing-file => {
        if (!editing-file) { key-scope.focus(); }
    }

    // And the same when the reader clicks another pane while the editor
    // is open: the pane they clicked is drawn focused, so the keyboard
    // has to follow it rather than staying in a surface that is no
    // longer the thing they are looking at.
    changed focus-pane => {
        if (editing-file && focus-pane != 2) { key-scope.focus(); }
    }

    key-scope := FocusScope {
        key-pressed(event) => {
            // A key that gets here while the editor has the keyboard is
            // one the editing surface did not want. Four of them still
            // mean something; the rest are the Contents pane's - rename,
            // new file, the arrows, the type-ahead - and must not fire
            // into a file somebody is in the middle of typing.
            //
            // Once the reader clicks another pane the file is still open
            // but the editor is no longer the focused pane, and the pane
            // they clicked has to answer its own keys - otherwise the
            // pane drawn as focused is not the one listening.
            if (editing-file && focus-pane == 2) {
                if (event.text == Key.Escape) {
                    cancel-requested();
                } else if (event.modifiers.control && (event.text == "s" || event.text == "S")) {
                    save-requested();
                } else if (event.modifiers.control && (event.text == "z" || event.text == "Z")) {
                    undo-requested();
                } else if (event.text == Key.F5) {
                    refresh-requested();
                }
                return accept;
            }
            if (event.text == Key.Escape) {
                cancel-requested();
            } else if (event.text == Key.Delete) {
                delete-requested();
            } else if (event.text == Key.Return) {
                return-pressed();
            } else if (event.text == Key.Backspace) {
                backspace-pressed();
            } else if (event.text == Key.F2) {
                content-rename-requested();
            } else if (event.text == Key.UpArrow && event.modifiers.alt) {
                parent-requested();
            } else if (event.modifiers.control && event.modifiers.shift && (event.text == "f" || event.text == "F")) {
                find-requested();
            } else if (event.modifiers.control && event.modifiers.shift && (event.text == "n" || event.text == "N")) {
                new-folder-requested();
            } else if (event.modifiers.control && (event.text == "n" || event.text == "N")) {
                new-file-requested();
            } else if (event.modifiers.alt && event.text == Key.LeftArrow) {
                back-requested();
            } else if (event.modifiers.alt && event.text == Key.RightArrow) {
                forward-requested();
            } else if (event.modifiers.control && (event.text == "z" || event.text == "Z")) {
                undo-requested();
            } else if (event.modifiers.control && (event.text == "a" || event.text == "A")) {
                select-all-requested();
            } else if (event.modifiers.control && (event.text == "c" || event.text == "C")) {
                clipboard-copy-requested();
            } else if (event.modifiers.control && (event.text == "x" || event.text == "X")) {
                clipboard-cut-requested();
            } else if (event.modifiers.control && (event.text == "v" || event.text == "V")) {
                clipboard-paste-requested();
            } else if (event.text == Key.F4
                || (event.modifiers.control && (event.text == "l" || event.text == "L"))) {
                path-edit-requested();
            } else if (event.modifiers.control && (event.text == "s" || event.text == "S")) {
                save-requested();
            } else if (event.modifiers.control && (event.text == "e" || event.text == "E")) {
                edit-requested();
            } else if (event.text == Key.F5) {
                refresh-requested();
            } else if (event.text == Key.Home) {
                if (event.modifiers.shift) { edge-extended(0); } else { edge-requested(0); }
            } else if (event.text == Key.End) {
                if (event.modifiers.shift) { edge-extended(1); } else { edge-requested(1); }
            } else if (event.text == Key.PageUp) {
                if (event.modifiers.shift) { selection-extended(-10); } else { selection-moved(-10); }
            } else if (event.text == Key.PageDown) {
                if (event.modifiers.shift) { selection-extended(10); } else { selection-moved(10); }
            } else if (event.text == Key.UpArrow) {
                if (event.modifiers.shift) { selection-extended(-1); } else { selection-moved(-1); }
            } else if (event.text == Key.DownArrow) {
                if (event.modifiers.shift) { selection-extended(1); } else { selection-moved(1); }
            } else if (event.text == Key.RightArrow) {
                pane-cycled(1);
            } else if (event.text == Key.LeftArrow) {
                pane-cycled(-1);
            } else {
                key-text(event.text);
            }
            accept
        }

        VerticalLayout {
            // Menu bar.
            Rectangle {
                height: 24px;
                background: Theme.panel;
                // The menu bar is its own strip: the command bar below is a
                // different kind of thing and should not run into it.
                ChromeEdge {
                    y: parent.height - 1px;
                }
                HorizontalLayout {
                    alignment: start;
                    MenuTitle {
                        label: "File";
                        open: open-menu == 0;
                        activated => { open-menu = open-menu == 0 ? -1 : 0; }
                    }
                    MenuTitle {
                        label: "Edit";
                        open: open-menu == 1;
                        activated => { open-menu = open-menu == 1 ? -1 : 1; }
                    }
                    MenuTitle {
                        label: "View";
                        open: open-menu == 2;
                        activated => { open-menu = open-menu == 2 ? -1 : 2; }
                    }
                    MenuTitle {
                        label: "Help";
                        open: open-menu == 3;
                        activated => { open-menu = open-menu == 3 ? -1 : 3; }
                    }
                }
            }

            // Command bar.
            Rectangle {
                height: 30px;
                background: Theme.panel;
                // The edge that ends the chrome: everything below this line
                // is content.
                ChromeEdge {
                    y: parent.height - 1px;
                }
                HorizontalLayout {
                    padding-left: 6px;
                    padding-top: 3px;
                    padding-bottom: 4px;
                    spacing: 1px;
                    alignment: start;
                    CommandButton {
                        label: "New folder";
                        activated => { new-folder-requested(); }
                    }
                    CommandButton {
                        label: "New file";
                        activated => { new-file-requested(); }
                    }
                    CommandSeparator { }
                    CommandButton {
                        label: "Cut";
                        button-enabled: has-selection;
                        activated => { clipboard-cut-requested(); }
                    }
                    CommandButton {
                        label: "Copy";
                        button-enabled: has-selection;
                        activated => { clipboard-copy-requested(); }
                    }
                    CommandButton {
                        label: "Paste";
                        button-enabled: can-paste;
                        activated => { clipboard-paste-requested(); }
                    }
                    CommandSeparator { }
                    CommandButton {
                        label: "Rename";
                        button-enabled: has-selection;
                        activated => { content-rename-requested(); }
                    }
                    CommandButton {
                        label: "Delete";
                        button-enabled: has-selection;
                        activated => { delete-requested(); }
                    }
                    CommandButton {
                        label: "Extract";
                        button-enabled: content-is-archive;
                        activated => { content-extract-requested(); }
                    }
                    CommandSeparator { }
                    CommandButton {
                        label: "Edit";
                        button-enabled: can-edit;
                        activated => { edit-requested(); }
                    }
                    CommandButton {
                        label: "Save";
                        button-enabled: editing-file;
                        activated => { save-requested(); }
                    }
                    CommandSeparator { }
                    CommandButton {
                        label: "Undo";
                        activated => { undo-requested(); }
                    }
                    CommandButton {
                        label: "Refresh";
                        activated => { refresh-requested(); }
                    }
                }
            }

            // Navigation and address bar.
            Rectangle {
                height: 30px;
                background: Theme.panel;
                HorizontalLayout {
                    padding: 2px;
                    spacing: 2px;
                    NavButton {
                        // U+2190 / U+2192 / U+2191: the plain arrows.
                        glyph: "\u{2190}";
                        button-enabled: can-go-back;
                        activated => { back-requested(); }
                    }
                    NavButton {
                        glyph: "\u{2192}";
                        button-enabled: can-go-forward;
                        activated => { forward-requested(); }
                    }
                    // Back and forward are a pair - they walk one history -
                    // and up is not: it is a move, not a step backwards.
                    CommandSeparator { }
                    NavButton {
                        glyph: "\u{2191}";
                        button-enabled: can-go-up;
                        activated => { parent-requested(); }
                    }
                    Rectangle {
                        width: 6px;
                    }
                    // The address bar. Segments while browsing, a text field
                    // while a path is being typed, the way Explorer's is.
                    Rectangle {
                        horizontal-stretch: 1;
                        background: Theme.field;
                        border-width: 1px;
                        border-color: editing-path ? Theme.accent : Theme.hover;
                        border-radius: 3px;

                        // Declared first so it sits under the segments: a
                        // click that misses one lands here and starts
                        // editing, as clicking past the path in Explorer
                        // does. Later siblings take their own clicks.
                        TouchArea {
                            width: 100%;
                            height: 100%;
                            mouse-cursor: text;
                            clicked => { path-edit-requested(); }
                        }

                        if editing-path: HorizontalLayout {
                            padding-left: 6px;
                            padding-right: 6px;
                            spacing: 2px;
                            alignment: start;
                            Text {
                                text: path-input;
                                color: Palette.foreground;
                                vertical-alignment: center;
                            }
                            Rectangle {
                                width: 1px;
                                background: Theme.accent;
                                y: 4px;
                                height: parent.height - 8px;
                            }
                            Text {
                                text: "  (Enter / Esc)";
                                color: Theme.dim-text;
                                vertical-alignment: center;
                            }
                        }

                        if !editing-path: HorizontalLayout {
                            padding-left: 4px;
                            padding-right: 2px;
                            spacing: 2px;
                            alignment: start;
                            Image {
                                source: location-icon;
                                width: 16px;
                                height: 16px;
                                image-fit: contain;
                                y: (parent.height - 16px) / 2;
                            }
                            // A path longer than the bar collapses its
                            // leading segments behind this, which expands
                            // them rather than hiding them behind a menu.
                            if first-crumb > 0: Crumb {
                                label: "\u{2026}";
                                activated => { crumbs-expanded = true; }
                            }
                            for crumb[i] in breadcrumbs: HorizontalLayout {
                                if i >= first-crumb: Crumb {
                                    label: crumb;
                                    last: i == breadcrumbs.length - 1;
                                    activated => { breadcrumb-requested(i); }
                                }
                                if i >= first-crumb && i < breadcrumbs.length - 1: Text {
                                    text: "\u{203A}";
                                    color: Theme.dim-text;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }
            }
            HorizontalLayout {
                spacing: 2px;
                folders-pane := Pane {
                    title: "Folders";
                    focused: focus-pane == 0;
                    rows: folder-rows;
                    selected: folder-selected;
                    scroll-y <=> folders-scroll-y;
                    width: folders-width;
                    horizontal-stretch: 0;
                    row-clicked(i, x) => { folder-row-clicked(i, x); }
                    row-double-clicked(i) => { folder-row-double-clicked(i); }
                }
                Splitter {
                    dragged(delta) => {
                        folders-width = clamp(folders-width + delta, 120px, root.width - contents-width - 200px);
                    }
                }
                contents-pane := ContentsPane {
                    title: "Contents";
                    focused: focus-pane == 1;
                    rows: content-rows;
                    selected: content-selected;
                    scroll-y <=> content-scroll-y;
                    width: contents-width;
                    horizontal-stretch: 0;
                    row-clicked(i) => { content-row-clicked(i); }
                    row-ctrl-clicked(i) => { content-row-ctrl-clicked(i); }
                    row-shift-clicked(i) => { content-row-shift-clicked(i); }
                    rows-marqueed(from, to) => { content-rows-marqueed(from, to); }
                    row-double-clicked(i) => { content-row-double-clicked(i); }
                    open-requested => { content-open-requested(); }
                    rename-requested => { content-rename-requested(); }
                    can-open: can-open;
                    web-provider: web-provider;
                    open-web-requested => { open-web-requested(); }
                    copy-requested => { content-copy-requested(); }
                    clipboard-copy-requested => { clipboard-copy-requested(); }
                    delete-requested => { content-delete-requested(); }
                    extract-requested => { content-extract-requested(); }
                    extract-enabled: content-is-archive;
                    prompt-text: content-prompt-text;
                    prompt-row: content-prompt-row;
                    prompt-editable: content-prompt-editable;
                    sort-column: showing-found ? -1 : content-sort-column;
                    showing-found: showing-found;
                    sort-ascending: content-sort-ascending;
                    sort-requested(c) => { content-sort-requested(c); }
                    new-folder-requested => { new-folder-requested(); }
                    new-file-requested => { new-file-requested(); }
                }
                Splitter {
                    dragged(delta) => {
                        contents-width = clamp(contents-width + delta, 200px, root.width - folders-width - 160px);
                    }
                }
                file-pane := Rectangle {
                    horizontal-stretch: 1;
                    border-width: 1px;
                    border-color: focus-pane == 2 ? Theme.accent : Theme.border;
                    VerticalLayout {
                        Text {
                            text: "File";
                            font-weight: 700;
                            color: focus-pane == 2 ? Theme.accent : Theme.heading-text;
                            height: 22px;
                            horizontal-alignment: center;
                        }
                        // The editor, when a file is open in it. The plugin
                        // decides which types get here; the pane just draws
                        // what it is handed.
                        // The editor's own commands, laid out the way a
                        // Windows editor lays them out: what is done to
                        // the text, then the clipboard, then the way out.
                        // Greyed when they do not apply, like the
                        // window's toolbar above.
                        if editing-file: Rectangle {
                            height: 26px;
                            background: Theme.panel;
                            HorizontalLayout {
                                padding-left: 4px;
                                padding-right: 4px;
                                spacing: 2px;
                                alignment: start;
                                CommandButton {
                                    label: edit-modified ? "Save *" : "Save";
                                    button-enabled: edit-modified;
                                    activated => { save-requested(); }
                                }
                                CommandSeparator { }
                                CommandButton {
                                    label: "Undo";
                                    button-enabled: edit-can-undo;
                                    activated => { edit-undo-requested(); }
                                }
                                CommandButton {
                                    label: "Redo";
                                    button-enabled: edit-can-redo;
                                    activated => { edit-redo-requested(); }
                                }
                                CommandSeparator { }
                                CommandButton {
                                    label: "Cut";
                                    button-enabled: edit-has-selection;
                                    activated => { edit-cut-requested(); }
                                }
                                CommandButton {
                                    label: "Copy";
                                    button-enabled: edit-has-selection;
                                    activated => { edit-copy-requested(); }
                                }
                                CommandButton {
                                    label: "Paste";
                                    activated => { edit-paste-requested(); }
                                }
                                CommandSeparator { }
                                CommandButton {
                                    label: "Close";
                                    activated => { cancel-requested(); }
                                }
                            }
                        }
                        // Where the caret is, which is what every Windows
                        // editor puts at the bottom of its window.
                        if editing-file: Rectangle {
                            height: 20px;
                            background: Theme.panel;
                            HorizontalLayout {
                                padding-left: 6px;
                                alignment: start;
                                caret-readout := Text {
                                    text: "Ln " + edit-line + ", Col " + edit-column;
                                    color: Theme.dim-text;
                                    vertical-alignment: center;
                                    accessible-role: text;
                                    accessible-label: self.text;
                                }
                            }
                        }
                        // Both editors live in here rather than beside
                        // each other, so that how many rows a page is can
                        // be measured. An element inside an `if` cannot
                        // be named from outside it, and a page that was a
                        // fixed number of rows would be a different
                        // distance in every window size.
                        if editing-file: Rectangle {
                            if editing-in-colour: CodeEditor {
                                width: 100%;
                                height: 100%;
                                lines: edit-lines;
                                caret-line: edit-caret-line;
                                caret-column: edit-caret-column;
                                selection-start-line: edit-selection-start-line;
                                selection-start-column: edit-selection-start-column;
                                selection-end-line: edit-selection-end-line;
                                selection-end-column: edit-selection-end-column;
                                longest-line: edit-longest-line;
                                focused: focus-pane == 2;
                                key(text, shift, control) => { return edit-key(text, shift, control); }
                                pressed(line, column) => { edit-pressed(line, column); }
                            }
                            // The file the coloured surface cannot serve
                            // gets Slint's own box, which can: it has the
                            // input method and the bidirectional layout
                            // that the hand-written one does not.
                            if !editing-in-colour: TextEdit {
                                width: 100%;
                                height: 100%;
                                text <=> edit-text;
                                wrap: no-wrap;
                            }
                        }

                        // The type's own views, when it offers more than
                        // one. A tab per view, in the plugin's order, at a
                        // fixed width - one TouchArea over the strip maps a
                        // click back to its tab, for the same Slint for-loop
                        // bug the row panes work around: a TouchArea created
                        // inside a for loop never reports a click.
                        // Shown whenever there is more than one thing to
                        // choose, which now includes a single-view file
                        // that can be edited - that Edit tab is the only
                        // sign the pane gives that an editor exists.
                        if file-tabs.length > 1: Rectangle {
                            height: tab-h;
                            background: Theme.panel;
                            Rectangle {
                                x: file-tab-index * tab-w;
                                y: 0;
                                width: tab-w;
                                height: tab-h;
                                background: Theme.accent;
                            }
                            for name[i] in file-tabs: Text {
                                text: name;
                                x: i * tab-w;
                                y: 0;
                                width: tab-w;
                                height: tab-h;
                                color: i == file-tab-index
                                    ? Theme.on-accent
                                    : Palette.foreground;
                                vertical-alignment: center;
                                horizontal-alignment: center;
                            }
                            tab-touch := TouchArea {
                                width: 100%;
                                height: 100%;
                                clicked => {
                                    file-tab-selected(clamp(floor(tab-touch.mouse-x / tab-w), 0, file-tabs.length - 1));
                                }
                            }
                        }

                        // A picture, for the types that are one, above the
                        // text the plugin also supplies.
                        if !editing-file && file-has-graphic: Rectangle {
                            // A fixed band rather than a share of the pane:
                            // deriving it from the parent closes a layout
                            // binding loop, since the parent sizes to its
                            // children.
                            height: 220px;
                            Image {
                                source: file-graphic;
                                image-fit: contain;
                                width: parent.width - 8px;
                                height: 212px;
                            }
                        }
                        // Coloured: fixed-width, and no wrapping, because a
                        // wrapped line of code puts the second half under a
                        // column it has nothing to do with. Scrolls sideways
                        // instead, which is what an editor does.
                        if !editing-file && file-lines.length > 0: coloured := ScrollView {
                            VerticalLayout {
                                alignment: start;
                                padding: 4px;
                                for line[row] in file-lines: HorizontalLayout {
                                    alignment: start;
                                    height: 16px;
                                    // Named so a test can ask what the pane
                                    // drew: runs computed correctly and
                                    // painted as one string would pass every
                                    // other test in the sequence.
                                    for run in line: syntax-run := Text {
                                        text: run.text;
                                        accessible-role: text;
                                        accessible-label: run.text;
                                        color: Theme.syntax-colour(run.class);
                                        font-family: "Consolas, Menlo, monospace";
                                        font-size: 12px;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                        if !editing-file && file-lines.length == 0: view := ScrollView {
                            Text {
                                text: file-text;
                                color: Palette.foreground;
                                wrap: word-wrap;
                                // Both needed: an element with no `x`/`y` is
                                // centred in its parent, so without these a
                                // short preview floats in the middle of the
                                // pane instead of starting at the top.
                                x: 4px;
                                y: 4px;
                                width: view.visible-width - 8px;
                            }
                        }
                    }
                }
            }
            Text {
                text: status-text;
                color: Palette.foreground;
                height: 22px;
                x: 4px;
                vertical-alignment: center;
            }
        }

        // The open menu's dropdown, and a full-window catcher behind it so a
        // click anywhere else closes the menu. Declared after the panes so
        // they draw over them.
        if open-menu >= 0: TouchArea {
            width: 100%;
            height: 100%;
            clicked => { open-menu = -1; }
        }

        if open-menu == 0: Rectangle {
            x: 4px;
            y: 24px;
            width: 210px;
            height: file-menu-items.preferred-height;
            background: Theme.panel;
            border-width: 1px;
            border-color: Theme.border;
            file-menu-items := VerticalLayout {
                ContextMenuItem {
                    label: "New Folder";
                    shortcut: "Ctrl+Shift+N";
                    item-height: menu-item-h;
                    activated => { open-menu = -1; new-folder-requested(); }
                }
                ContextMenuItem {
                    label: "New File";
                    shortcut: "Ctrl+N";
                    item-height: menu-item-h;
                    activated => { open-menu = -1; new-file-requested(); }
                }
                ContextMenuItem {
                    label: "Open";
                    // Open steps into a folder. On a file it did nothing
                    // at all, while looking exactly like a button that
                    // would.
                    item-enabled: can-open;
                    item-height: menu-item-h;
                    activated => { open-menu = -1; content-open-requested(); }
                }
                ContextMenuItem {
                    label: "Open on the web";
                    item-enabled: web-provider != "";
                    item-height: menu-item-h;
                    activated => { open-menu = -1; open-web-requested(); }
                }
                ContextMenuItem {
                    label: "Edit";
                    shortcut: "Ctrl+E";
                    item-enabled: can-edit;
                    item-height: menu-item-h;
                    activated => { open-menu = -1; edit-requested(); }
                }
                ContextMenuItem {
                    label: "Save";
                    shortcut: "Ctrl+S";
                    item-enabled: editing-file;
                    item-height: menu-item-h;
                    activated => { open-menu = -1; save-requested(); }
                }
                ContextMenuItem {
                    label: "Rename";
                    shortcut: "F2";
                    item-enabled: has-selection;
                    item-height: menu-item-h;
                    activated => { open-menu = -1; content-rename-requested(); }
                }
                ContextMenuItem {
                    label: "Delete";
                    shortcut: "Del";
                    item-enabled: has-selection;
                    item-height: menu-item-h;
                    activated => { open-menu = -1; delete-requested(); }
                }
                ContextMenuItem {
                    label: "Repos Directory...";
                    item-height: menu-item-h;
                    activated => { open-menu = -1; repos-root-requested(); }
                }
                ContextMenuItem {
                    label: "Exit";
                    item-height: menu-item-h;
                    activated => { open-menu = -1; quit-requested(); }
                }
            }
        }

        if open-menu == 1: Rectangle {
            x: 44px;
            y: 24px;
            width: 200px;
            height: edit-menu-items.preferred-height;
            background: Theme.panel;
            border-width: 1px;
            border-color: Theme.border;
            edit-menu-items := VerticalLayout {
                ContextMenuItem {
                    label: "Undo";
                    shortcut: "Ctrl+Z";
                    item-height: menu-item-h;
                    activated => { open-menu = -1; undo-requested(); }
                }
                ContextMenuItem {
                    label: "Cut";
                    shortcut: "Ctrl+X";
                    item-enabled: has-selection;
                    item-height: menu-item-h;
                    activated => { open-menu = -1; clipboard-cut-requested(); }
                }
                ContextMenuItem {
                    label: "Copy";
                    shortcut: "Ctrl+C";
                    item-enabled: has-selection;
                    item-height: menu-item-h;
                    activated => { open-menu = -1; clipboard-copy-requested(); }
                }
                ContextMenuItem {
                    label: "Paste";
                    shortcut: "Ctrl+V";
                    item-enabled: can-paste;
                    item-height: menu-item-h;
                    activated => { open-menu = -1; clipboard-paste-requested(); }
                }
                ContextMenuItem {
                    label: "Select All";
                    shortcut: "Ctrl+A";
                    item-height: menu-item-h;
                    activated => { open-menu = -1; select-all-requested(); }
                }
            }
        }

        if open-menu == 2: Rectangle {
            x: 88px;
            y: 24px;
            width: 210px;
            height: view-menu-items.preferred-height;
            background: Theme.panel;
            border-width: 1px;
            border-color: Theme.border;
            view-menu-items := VerticalLayout {
                ContextMenuItem {
                    label: "Refresh";
                    shortcut: "F5";
                    item-height: menu-item-h;
                    activated => { open-menu = -1; refresh-requested(); }
                }
                ContextMenuItem {
                    label: "Up One Level";
                    shortcut: "Backspace";
                    item-height: menu-item-h;
                    activated => { open-menu = -1; parent-requested(); }
                }
                ContextMenuItem {
                    label: "Sort by Name";
                    item-height: menu-item-h;
                    activated => { open-menu = -1; content-sort-requested(0); }
                }
                ContextMenuItem {
                    label: "Sort by Size";
                    item-height: menu-item-h;
                    activated => { open-menu = -1; content-sort-requested(1); }
                }
                ContextMenuItem {
                    label: "Sort by Type";
                    item-height: menu-item-h;
                    activated => { open-menu = -1; content-sort-requested(2); }
                }
                ContextMenuItem {
                    label: "Sort by Modified";
                    item-height: menu-item-h;
                    activated => { open-menu = -1; content-sort-requested(3); }
                }
            }
        }

        if open-menu == 3: Rectangle {
            x: 136px;
            y: 24px;
            width: 200px;
            height: help-menu-items.preferred-height;
            background: Theme.panel;
            border-width: 1px;
            border-color: Theme.border;
            help-menu-items := VerticalLayout {
                ContextMenuItem {
                    label: "About RepoSphereExplorer";
                    item-height: menu-item-h;
                    activated => { open-menu = -1; about-requested(); }
                }
            }
        }
    }
}
