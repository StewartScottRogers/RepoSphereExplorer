import { ScrollView, Palette } from "std-widgets.slint";

// Every colour comes from the system palette, so the window follows the
// Windows light/dark setting and its accent colour instead of being dark
// whatever the user chose. `Palette` reports the scheme the platform is
// using; the derived shades below are the handful of tones the panes need
// on top of it, expressed as offsets from the system's own so they stay
// right in both schemes.
global Theme {
    out property <bool> dark: Palette.color-scheme == ColorScheme.dark;
    // Panels sitting on the window background: toolbar, column header, menus.
    out property <brush> panel: dark
        ? Palette.background.brighter(0.35)
        : Palette.background.darker(0.06);
    // A sunken field, such as the address bar.
    out property <brush> field: dark
        ? Palette.background.darker(0.25)
        : Palette.background.brighter(0.6);
    // Hover feedback on a menu item or toolbar button.
    out property <brush> hover: dark
        ? Palette.background.brighter(0.7)
        : Palette.background.darker(0.12);
    // Secondary text: the size, type and date columns.
    out property <brush> dim-text: Palette.foreground.transparentize(0.35);
    // Text on a pane heading that is not focused.
    out property <brush> heading-text: Palette.foreground.transparentize(0.2);
    out property <brush> border: Palette.border;
    out property <brush> accent: Palette.accent-background;
    out property <brush> on-accent: Palette.accent-foreground;
}

component Pane inherits Rectangle {
    in property <string> title;
    in property <bool> focused;
    in property <[string]> rows;
    in property <int> selected;
    callback row-clicked(int);
    callback row-double-clicked(int);

    // A per-row `for`-loop generating `Rectangle`/`TouchArea` instances
    // leaves every instance but the first permanently unresponsive to real
    // mouse input under Slint 1.17.1 (matches upstream issue #6836).
    // Worked around with a `for`-loop of plain `Text` rows (which does not
    // trigger the bug), a single non-repeated highlight `Rectangle`, and one
    // overlay `TouchArea` that derives the clicked row from `mouse-y`.
    property <length> row-height: 20px;

    border-width: 1px;
    border-color: focused ? Theme.accent : Theme.border;

    VerticalLayout {
        Text {
            text: title;
            font-weight: 700;
            color: focused ? Theme.accent : Theme.heading-text;
            height: 22px;
            horizontal-alignment: center;
        }
        ScrollView {
            // `ScrollView` vertically centers a child shorter than its
            // viewport rather than pinning it to the top, so the row
            // container needs an explicit top-aligned layout around it.
            VerticalLayout {
                alignment: start;
                Rectangle {
                    height: max(rows.length * row-height, 1px);

                    Rectangle {
                        y: selected >= 0 ? selected * row-height : 0px;
                        height: selected >= 0 ? row-height : 0px;
                        background: Theme.accent;
                    }

                    for row[i] in rows: Text {
                        text: row;
                        color: i == selected ? Theme.on-accent : Palette.foreground;
                        y: i * row-height;
                        height: row-height;
                        vertical-alignment: center;
                        x: 4px;
                    }

                    click-area := TouchArea {
                        width: 100%;
                        height: 100%;
                        clicked => {
                            if (rows.length > 0) {
                                row-clicked(clamp(floor(click-area.mouse-y / row-height), 0, rows.length - 1));
                            }
                        }
                        double-clicked => {
                            if (rows.length > 0) {
                                row-double-clicked(clamp(floor(click-area.mouse-y / row-height), 0, rows.length - 1));
                            }
                        }
                    }
                }
            }
        }
    }
}

export struct ContentRow {
    icon: image,
    name: string,
    size: string,
    kind: string,
    modified: string,
    // Whether this row is part of the selection. With Ctrl and Shift in play
    // that is no longer "the one row whose index matches".
    selected: bool,
}

// One column heading in the contents pane's details view: clickable to sort,
// showing the direction arrow when it is the active column.
// A toolbar button: a square glyph button that greys out when it has nowhere
// to go, the way Explorer's back and forward arrows do.
component NavButton inherits Rectangle {
    in property <string> glyph;
    in property <bool> button-enabled: true;
    callback activated();

    width: 28px;
    background: button-enabled && nav-touch.has-hover ? Theme.hover : transparent;
    border-radius: 3px;

    Text {
        text: glyph;
        color: button-enabled ? Palette.foreground : Theme.dim-text;
        horizontal-alignment: center;
        vertical-alignment: center;
        width: 100%;
        height: 100%;
    }

    nav-touch := TouchArea {
        width: 100%;
        height: 100%;
        enabled: button-enabled;
        clicked => { activated(); }
    }
}

// One segment of the address bar's path, clickable to jump to that folder.
component Crumb inherits Rectangle {
    in property <string> label;
    in property <bool> last;
    callback activated();

    background: crumb-touch.has-hover && !last ? Theme.hover : transparent;
    border-radius: 3px;

    HorizontalLayout {
        padding-left: 6px;
        padding-right: 6px;
        Text {
            text: label;
            color: last ? Theme.accent : Palette.foreground;
            vertical-alignment: center;
        }
    }

    crumb-touch := TouchArea {
        width: 100%;
        height: 100%;
        enabled: !last;
        clicked => { activated(); }
    }
}

component ColumnHeader inherits Rectangle {
    in property <string> label;
    in property <bool> active;
    in property <bool> ascending;
    in property <bool> align-right;
    callback activated();

    background: heading-touch.has-hover ? Theme.hover : transparent;

    HorizontalLayout {
        padding-left: 4px;
        padding-right: 4px;
        alignment: align-right ? end : start;
        spacing: 2px;
        Text {
            text: label;
            color: active ? Theme.accent : Theme.heading-text;
            vertical-alignment: center;
            overflow: elide;
        }
        Text {
            // U+25B2 / U+25BC. The smaller U+25B4 / U+25BE render as tofu
            // in the default font here.
            text: active ? (ascending ? "\u{25B2}" : "\u{25BC}") : "";
            color: Theme.accent;
            vertical-alignment: center;
        }
    }

    heading-touch := TouchArea {
        width: 100%;
        height: 100%;
        clicked => { activated(); }
    }
}

// A draggable divider between two panes. Reports how far it was dragged so
// the window can widen one pane and narrow the next.
component Splitter inherits Rectangle {
    callback dragged(length);

    width: 5px;
    background: split-touch.has-hover || split-touch.pressed ? Theme.accent : Theme.border;

    split-touch := TouchArea {
        width: 100%;
        height: 100%;
        mouse-cursor: ew-resize;
        moved => {
            if (self.pressed) {
                dragged(self.mouse-x - self.pressed-x);
            }
        }
    }
}

// One title in the menu bar. Opening a menu is a property change rather
// than a `PopupWindow`, so the dropdown is an ordinary element of the window
// that can be sized, positioned and clicked like any other.
component MenuTitle inherits Rectangle {
    in property <string> label;
    in property <bool> open;
    callback activated();

    width: title-text.preferred-width + 20px;
    background: open ? Theme.accent : (title-touch.has-hover ? Theme.hover : transparent);

    title-text := Text {
        text: label;
        color: open ? Theme.on-accent : Palette.foreground;
        horizontal-alignment: center;
        vertical-alignment: center;
        width: 100%;
        height: 100%;
    }

    title-touch := TouchArea {
        width: 100%;
        height: 100%;
        clicked => { activated(); }
    }
}

// A labelled button on the command bar, greyed out when its command has
// nothing to act on.
component CommandButton inherits Rectangle {
    in property <string> label;
    in property <bool> button-enabled: true;
    callback activated();

    width: command-text.preferred-width + 16px;
    border-radius: 3px;
    background: button-enabled && command-touch.has-hover ? Theme.hover : transparent;

    command-text := Text {
        text: label;
        color: button-enabled ? Palette.foreground : Theme.dim-text;
        horizontal-alignment: center;
        vertical-alignment: center;
        width: 100%;
        height: 100%;
    }

    command-touch := TouchArea {
        width: 100%;
        height: 100%;
        enabled: button-enabled;
        clicked => { activated(); }
    }
}

// A thin vertical rule between groups of command buttons.
component CommandSeparator inherits Rectangle {
    width: 9px;
    Rectangle {
        width: 1px;
        height: 60%;
        y: (parent.height - self.height) / 2;
        background: Theme.border;
    }
}

component ContextMenuItem inherits Rectangle {
    in property <string> label;
    in property <string> shortcut;
    in property <bool> item-enabled: true;
    in property <length> item-height;
    callback activated();

    height: item-height;
    background: touch.has-hover ? Theme.accent : transparent;
    // Named for assistive technology, and so a test can find the item by
    // the label the user reads rather than by its position in the menu.
    accessible-role: button;
    accessible-label: label;
    accessible-enabled: item-enabled;

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 16px;
        Text {
            text: label;
            color: item-enabled ? Palette.foreground : Theme.dim-text;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
        Text {
            text: shortcut;
            color: Theme.dim-text;
            vertical-alignment: center;
            horizontal-stretch: 0;
        }
    }

    touch := TouchArea {
        width: 100%;
        height: 100%;
        enabled: item-enabled;
        clicked => { activated(); }
    }
}

// The contents pane's own variant of `Pane`, with a right-click context menu
// added on top of the same row rendering. Uses the same Text-row / single
// overlay TouchArea workaround as `Pane` (see its comment) for the Slint
// for-loop TouchArea bug - a per-row TouchArea here would also lose right-
// click delivery on every row past the first, not just left-click.
component ContentsPane inherits Rectangle {
    in property <string> title;
    in property <bool> focused;
    in property <[ContentRow]> rows;
    in property <int> selected;
    // Which column the list is sorted by, and which way, so the header can
    // show the indicator Explorer shows.
    in property <int> sort-column;
    in property <bool> sort-ascending;
    callback sort-requested(int);
    // Whether the selected row previewed as an archive; Extract is greyed
    // out otherwise, since extracting anything else only ever errors.
    in property <bool> extract-enabled;
    // The prompt a pending operation is waiting on, drawn over the row it
    // applies to. Without it the only sign that a menu action did anything
    // is one line at the very bottom of the window.
    in property <string> prompt-text;
    in property <int> prompt-row;
    in property <bool> prompt-editable;
    callback row-clicked(int);
    callback row-ctrl-clicked(int);
    callback row-shift-clicked(int);
    // A rubber-band drag, reported once on release as the row range it
    // covered.
    callback rows-marqueed(int, int);
    callback row-double-clicked(int);
    callback open-requested();
    callback rename-requested();
    callback copy-requested();
    callback delete-requested();
    callback extract-requested();
    callback new-folder-requested();
    callback new-file-requested();

    property <length> row-height: 20px;
    // Where the last right-click landed, which both popups place themselves
    // at: a `PopupWindow` cannot be positioned from its enclosing component,
    // so it has to read the coordinates out of a property instead.
    property <length> menu-x;
    property <length> menu-y;
    // A `PopupWindow` with no size of its own is laid out 0x0. Its contents
    // still draw - nothing clips them - but hit-testing is bounded by the
    // popup, so every item in it is unclickable. Both menus therefore state
    // their size, which means stating the item height and count here.
    property <length> menu-width: 150px;
    property <length> menu-item-height: 24px;
    // Which context menu is open: -1 none, 0 on a row, 1 on empty space.
    property <int> open-context: -1;
    // The rubber band, while one is being dragged. `band-from` is where the
    // press landed and `band-to` follows the pointer; a drag shorter than a
    // row is treated as a click, not a marquee.
    property <bool> banding;
    property <length> band-from;
    property <length> band-to;
    // Details-view columns. The three trailing ones are fixed and Name
    // stretches into the rest, in both the header and every row, so the two
    // line up without either deriving a width from the pane's own width -
    // which would close a layout binding loop.
    property <length> size-column: 80px;
    property <length> kind-column: 90px;
    property <length> modified-column: 118px;
    property <length> header-height: 20px;

    border-width: 1px;
    border-color: focused ? Theme.accent : Theme.border;

    VerticalLayout {
        Text {
            text: title;
            font-weight: 700;
            color: focused ? Theme.accent : Theme.heading-text;
            height: 22px;
            horizontal-alignment: center;
        }
        Rectangle {
            height: header-height;
            background: Theme.panel;
            HorizontalLayout {
                padding-left: 4px;
                padding-right: 4px;
                ColumnHeader {
                    horizontal-stretch: 1;
                    min-width: 40px;
                    label: "Name";
                    active: sort-column == 0;
                    ascending: sort-ascending;
                    activated => { sort-requested(0); }
                }
                ColumnHeader {
                    width: size-column;
                    horizontal-stretch: 0;
                    label: "Size";
                    align-right: true;
                    active: sort-column == 1;
                    ascending: sort-ascending;
                    activated => { sort-requested(1); }
                }
                ColumnHeader {
                    width: kind-column;
                    horizontal-stretch: 0;
                    align-right: true;
                    label: "Type";
                    active: sort-column == 2;
                    ascending: sort-ascending;
                    activated => { sort-requested(2); }
                }
                ColumnHeader {
                    width: modified-column;
                    horizontal-stretch: 0;
                    align-right: true;
                    label: "Modified";
                    active: sort-column == 3;
                    ascending: sort-ascending;
                    activated => { sort-requested(3); }
                }
            }
        }
        ScrollView {
            body := Rectangle {
                width: 100%;
                min-height: max(rows.length * row-height, root.height - 22px - header-height);

                for row[i] in rows: Rectangle {
                    y: i * row-height;
                    height: row.selected ? row-height : 0px;
                    width: 100%;
                    background: Theme.accent;
                }

                for row[i] in rows: Rectangle {
                    y: i * row-height;
                    height: row-height;
                    width: 100%;
                    HorizontalLayout {
                        padding-left: 4px;
                        padding-right: 4px;
                        HorizontalLayout {
                            horizontal-stretch: 1;
                            spacing: 5px;
                            padding-top: 2px;
                            padding-bottom: 2px;
                            Image {
                                source: row.icon;
                                width: 16px;
                                image-fit: contain;
                                horizontal-stretch: 0;
                            }
                            Text {
                                text: row.name;
                                color: row.selected ? Theme.on-accent : Palette.foreground;
                                overflow: elide;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                                min-width: 24px;
                            }
                        }
                        Text {
                            text: row.size;
                            color: row.selected ? Theme.on-accent : Theme.dim-text;
                            width: size-column;
                            horizontal-alignment: right;
                            vertical-alignment: center;
                            horizontal-stretch: 0;
                        }
                        Text {
                            text: row.kind;
                            color: row.selected ? Theme.on-accent : Theme.dim-text;
                            width: kind-column;
                            overflow: elide;
                            horizontal-alignment: right;
                            vertical-alignment: center;
                            horizontal-stretch: 0;
                        }
                        Text {
                            text: row.modified;
                            color: row.selected ? Theme.on-accent : Theme.dim-text;
                            width: modified-column;
                            overflow: elide;
                            horizontal-alignment: right;
                            vertical-alignment: center;
                            horizontal-stretch: 0;
                        }
                    }
                }

                if prompt-row >= 0: Rectangle {
                    y: prompt-row * row-height;
                    height: row-height;
                    width: 100%;
                    background: Theme.field;
                    border-width: 1px;
                    border-color: Theme.accent;
                    HorizontalLayout {
                        padding-left: 4px;
                        spacing: 2px;
                        alignment: start;
                        Text {
                            text: prompt-text;
                            color: Theme.accent;
                            vertical-alignment: center;
                        }
                        // A caret, so a text prompt reads as one waiting for
                        // typing rather than as a label.
                        Rectangle {
                            width: prompt-editable ? 1px : 0px;
                            background: Theme.accent;
                            y: 3px;
                            height: row-height - 6px;
                        }
                        Text {
                            text: prompt-editable ? "  (Enter / Esc)" : "";
                            color: Theme.dim-text;
                            vertical-alignment: center;
                        }
                    }
                }

                if banding: Rectangle {
                    y: min(band-from, band-to);
                    height: abs(band-to - band-from);
                    width: 100%;
                    background: Theme.accent.transparentize(0.75);
                    border-width: 1px;
                    border-color: Theme.accent;
                }

                click-area := TouchArea {
                    width: 100%;
                    height: 100%;
                    moved => {
                        if (click-area.pressed) {
                            band-to = click-area.mouse-y;
                            // A press that has not travelled a row's height
                            // is still a click; only past that is it a drag.
                            if (abs(band-to - band-from) >= row-height) {
                                banding = true;
                            }
                        }
                    }
                    double-clicked => {
                        if (rows.length > 0 && click-area.mouse-y < rows.length * row-height) {
                            row-double-clicked(clamp(floor(click-area.mouse-y / row-height), 0, rows.length - 1));
                        }
                    }
                    pointer-event(event) => {
                        if (event.kind == PointerEventKind.down) {
                            // Any press dismisses an open context menu; the
                            // item's own handler runs first when the press
                            // landed on one.
                            open-context = -1;
                            band-from = click-area.mouse-y;
                            band-to = click-area.mouse-y;
                        }
                        if (event.kind == PointerEventKind.up && banding) {
                            banding = false;
                            if (rows.length > 0) {
                                rows-marqueed(
                                    clamp(floor(min(band-from, band-to) / row-height), 0, rows.length - 1),
                                    clamp(floor(max(band-from, band-to) / row-height), 0, rows.length - 1));
                            }
                        }
                        if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left && !banding) {
                            if (rows.length > 0 && click-area.mouse-y < rows.length * row-height) {
                                if (event.modifiers.control) {
                                    row-ctrl-clicked(clamp(floor(click-area.mouse-y / row-height), 0, rows.length - 1));
                                } else if (event.modifiers.shift) {
                                    row-shift-clicked(clamp(floor(click-area.mouse-y / row-height), 0, rows.length - 1));
                                } else {
                                    row-clicked(clamp(floor(click-area.mouse-y / row-height), 0, rows.length - 1));
                                }
                            }
                        }
                        if (event.kind == PointerEventKind.down && event.button == PointerEventButton.right) {
                            if (rows.length > 0 && click-area.mouse-y < rows.length * row-height) {
                                row-clicked(clamp(floor(click-area.mouse-y / row-height), 0, rows.length - 1));
                                // Open at the pointer: a `PopupWindow` with no
                                // placement of its own lands at the pane's
                                // top-left corner, half over the folders pane.
                                menu-x = click-area.mouse-x;
                                menu-y = click-area.mouse-y;
                                open-context = 0;
                            } else {
                                menu-x = click-area.mouse-x;
                                menu-y = click-area.mouse-y;
                                open-context = 1;
                            }
                        }
                    }
                }

                // The context menus are ordinary elements rather than
                // `PopupWindow`s: a popup cannot be positioned from its
                // enclosing component, has to be sized by hand or it is laid
                // out 0x0 with its contents unhittable, and its default close
                // policy eats the click that chooses an item. An element in
                // the pane has none of those problems.
                if open-context == 1: Rectangle {
                    x: menu-x;
                    y: menu-y;
                    width: menu-width;
                    height: 2 * menu-item-height;
                    background: Theme.panel;
                    border-width: 1px;
                    border-color: Theme.border;
                    VerticalLayout {
                        ContextMenuItem {
                            label: "New Folder";
                            item-height: menu-item-height;
                            activated => { open-context = -1; new-folder-requested(); }
                        }
                        ContextMenuItem {
                            label: "New File";
                            item-height: menu-item-height;
                            activated => { open-context = -1; new-file-requested(); }
                        }
                    }
                }

                if open-context == 0: Rectangle {
                    x: menu-x;
                    y: menu-y;
                    width: menu-width;
                    height: 5 * menu-item-height;
                    background: Theme.panel;
                    border-width: 1px;
                    border-color: Theme.border;
                    VerticalLayout {
                        ContextMenuItem {
                            label: "Open";
                            item-height: menu-item-height;
                            activated => { open-context = -1; open-requested(); }
                        }
                        ContextMenuItem {
                            label: "Rename";
                            shortcut: "F2";
                            item-height: menu-item-height;
                            activated => { open-context = -1; rename-requested(); }
                        }
                        ContextMenuItem {
                            label: "Copy";
                            shortcut: "Ctrl+C";
                            item-height: menu-item-height;
                            activated => { open-context = -1; copy-requested(); }
                        }
                        ContextMenuItem {
                            label: "Delete";
                            shortcut: "Del";
                            item-height: menu-item-height;
                            activated => { open-context = -1; delete-requested(); }
                        }
                        ContextMenuItem {
                            label: "Extract";
                            item-height: menu-item-height;
                            item-enabled: extract-enabled;
                            activated => { open-context = -1; extract-requested(); }
                        }
                    }
                }
            }
        }
    }
}

export component MainWindow inherits Window {
    title: "RepoSphereExplorer";
    preferred-width: 1000px;
    preferred-height: 600px;
    background: Palette.background;
    // Windows' UI font. Slint falls back to the platform default wherever
    // it is not installed, so this costs nothing on other systems.
    default-font-family: "Segoe UI";

    in property <[string]> folder-rows;
    in property <int> folder-selected;
    in property <[ContentRow]> content-rows;
    in property <int> content-selected;
    in property <string> file-text;
    // A picture for the previewed file, when its type is one.
    in property <image> file-graphic;
    in property <bool> file-has-graphic;
    in property <string> status-text;
    in property <int> focus-pane;

    callback folder-row-clicked(int);
    callback folder-row-double-clicked(int);
    callback content-row-clicked(int);
    callback content-row-ctrl-clicked(int);
    callback content-row-shift-clicked(int);
    callback content-rows-marqueed(int, int);
    callback content-row-double-clicked(int);
    callback content-open-requested();
    callback content-rename-requested();
    callback content-copy-requested();
    callback content-delete-requested();
    callback content-extract-requested();
    callback cancel-requested();
    callback delete-requested();
    callback return-pressed();
    callback backspace-pressed();
    callback key-text(string);
    callback parent-requested();
    callback new-folder-requested();
    callback new-file-requested();
    callback selection-moved(int);
    callback pane-cycled(int);
    // Whether the selected contents row previewed as an archive.
    in property <bool> content-is-archive;
    // The prompt a pending operation is waiting on, and the row it applies to.
    in property <string> content-prompt-text;
    in property <int> content-prompt-row: -1;
    in property <bool> content-prompt-editable;
    // What the command bar and menus enable from.
    in property <bool> has-selection;
    in property <bool> can-paste;
    callback quit-requested();
    callback about-requested();
    // Which contents column is sorted on, and which way.
    in property <int> content-sort-column;
    in property <bool> content-sort-ascending;
    callback content-sort-requested(int);
    // Address bar and history navigation.
    in property <[string]> breadcrumbs;
    in property <bool> can-go-back;
    in property <bool> can-go-forward;
    callback back-requested();
    callback forward-requested();
    callback breadcrumb-requested(int);
    // Windows clipboard and list navigation keys.
    callback clipboard-copy-requested();
    callback clipboard-cut-requested();
    callback clipboard-paste-requested();
    callback refresh-requested();
    callback select-all-requested();
    callback undo-requested();
    // Pane widths, moved by the splitters between them. The file pane takes
    // whatever the other two leave.
    // `in-out` so the widths can be restored at startup and read back when
    // the window closes; the splitters move them in between.
    in-out property <length> folders-width: 240px;
    in-out property <length> contents-width: 470px;
    // Which menu is open: -1 none, then File, Edit, View, Help. A menu is a
    // property rather than a `PopupWindow` so it can be sized, placed and
    // clicked like any other element.
    property <int> open-menu: -1;
    property <length> menu-item-h: 24px;
    callback edge-requested(int);

    forward-focus: key-scope;

    key-scope := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                cancel-requested();
            } else if (event.text == Key.Delete) {
                delete-requested();
            } else if (event.text == Key.Return) {
                return-pressed();
            } else if (event.text == Key.Backspace) {
                backspace-pressed();
            } else if (event.text == Key.F2) {
                content-rename-requested();
            } else if (event.text == Key.UpArrow && event.modifiers.alt) {
                parent-requested();
            } else if (event.modifiers.control && event.modifiers.shift && (event.text == "n" || event.text == "N")) {
                new-folder-requested();
            } else if (event.modifiers.control && (event.text == "n" || event.text == "N")) {
                new-file-requested();
            } else if (event.modifiers.alt && event.text == Key.LeftArrow) {
                back-requested();
            } else if (event.modifiers.alt && event.text == Key.RightArrow) {
                forward-requested();
            } else if (event.modifiers.control && (event.text == "z" || event.text == "Z")) {
                undo-requested();
            } else if (event.modifiers.control && (event.text == "a" || event.text == "A")) {
                select-all-requested();
            } else if (event.modifiers.control && (event.text == "c" || event.text == "C")) {
                clipboard-copy-requested();
            } else if (event.modifiers.control && (event.text == "x" || event.text == "X")) {
                clipboard-cut-requested();
            } else if (event.modifiers.control && (event.text == "v" || event.text == "V")) {
                clipboard-paste-requested();
            } else if (event.text == Key.F5) {
                refresh-requested();
            } else if (event.text == Key.Home) {
                edge-requested(0);
            } else if (event.text == Key.End) {
                edge-requested(1);
            } else if (event.text == Key.PageUp) {
                selection-moved(-10);
            } else if (event.text == Key.PageDown) {
                selection-moved(10);
            } else if (event.text == Key.UpArrow) {
                selection-moved(-1);
            } else if (event.text == Key.DownArrow) {
                selection-moved(1);
            } else if (event.text == Key.RightArrow) {
                pane-cycled(1);
            } else if (event.text == Key.LeftArrow) {
                pane-cycled(-1);
            } else {
                key-text(event.text);
            }
            accept
        }

        VerticalLayout {
            // Menu bar.
            Rectangle {
                height: 24px;
                background: Theme.panel;
                HorizontalLayout {
                    alignment: start;
                    MenuTitle {
                        label: "File";
                        open: open-menu == 0;
                        activated => { open-menu = open-menu == 0 ? -1 : 0; }
                    }
                    MenuTitle {
                        label: "Edit";
                        open: open-menu == 1;
                        activated => { open-menu = open-menu == 1 ? -1 : 1; }
                    }
                    MenuTitle {
                        label: "View";
                        open: open-menu == 2;
                        activated => { open-menu = open-menu == 2 ? -1 : 2; }
                    }
                    MenuTitle {
                        label: "Help";
                        open: open-menu == 3;
                        activated => { open-menu = open-menu == 3 ? -1 : 3; }
                    }
                }
            }

            // Command bar.
            Rectangle {
                height: 28px;
                background: Theme.panel;
                HorizontalLayout {
                    padding-left: 4px;
                    padding-top: 2px;
                    padding-bottom: 2px;
                    spacing: 1px;
                    alignment: start;
                    CommandButton {
                        label: "New folder";
                        activated => { new-folder-requested(); }
                    }
                    CommandButton {
                        label: "New file";
                        activated => { new-file-requested(); }
                    }
                    CommandSeparator { }
                    CommandButton {
                        label: "Cut";
                        button-enabled: has-selection;
                        activated => { clipboard-cut-requested(); }
                    }
                    CommandButton {
                        label: "Copy";
                        button-enabled: has-selection;
                        activated => { clipboard-copy-requested(); }
                    }
                    CommandButton {
                        label: "Paste";
                        button-enabled: can-paste;
                        activated => { clipboard-paste-requested(); }
                    }
                    CommandSeparator { }
                    CommandButton {
                        label: "Rename";
                        button-enabled: has-selection;
                        activated => { content-rename-requested(); }
                    }
                    CommandButton {
                        label: "Delete";
                        button-enabled: has-selection;
                        activated => { delete-requested(); }
                    }
                    CommandButton {
                        label: "Extract";
                        button-enabled: content-is-archive;
                        activated => { content-extract-requested(); }
                    }
                    CommandSeparator { }
                    CommandButton {
                        label: "Undo";
                        activated => { undo-requested(); }
                    }
                    CommandButton {
                        label: "Refresh";
                        activated => { refresh-requested(); }
                    }
                }
            }

            // Navigation and address bar.
            Rectangle {
                height: 30px;
                background: Theme.panel;
                HorizontalLayout {
                    padding: 2px;
                    spacing: 2px;
                    NavButton {
                        // U+2190 / U+2192 / U+2191: the plain arrows.
                        glyph: "\u{2190}";
                        button-enabled: can-go-back;
                        activated => { back-requested(); }
                    }
                    NavButton {
                        glyph: "\u{2192}";
                        button-enabled: can-go-forward;
                        activated => { forward-requested(); }
                    }
                    NavButton {
                        glyph: "\u{2191}";
                        activated => { parent-requested(); }
                    }
                    Rectangle {
                        width: 6px;
                    }
                    // The address bar: one clickable segment per path
                    // component, the last being the folder being browsed.
                    Rectangle {
                        horizontal-stretch: 1;
                        background: Theme.field;
                        border-width: 1px;
                        border-color: Theme.hover;
                        border-radius: 3px;
                        HorizontalLayout {
                            padding-left: 2px;
                            padding-right: 2px;
                            alignment: start;
                            for crumb[i] in breadcrumbs: HorizontalLayout {
                                Crumb {
                                    label: crumb;
                                    last: i == breadcrumbs.length - 1;
                                    activated => { breadcrumb-requested(i); }
                                }
                                Text {
                                    text: i == breadcrumbs.length - 1 ? "" : "\u{203A}";
                                    color: Theme.dim-text;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }
            }
            HorizontalLayout {
                spacing: 2px;
                Pane {
                    title: "Folders";
                    focused: focus-pane == 0;
                    rows: folder-rows;
                    selected: folder-selected;
                    width: folders-width;
                    horizontal-stretch: 0;
                    row-clicked(i) => { folder-row-clicked(i); }
                    row-double-clicked(i) => { folder-row-double-clicked(i); }
                }
                Splitter {
                    dragged(delta) => {
                        folders-width = clamp(folders-width + delta, 120px, root.width - contents-width - 200px);
                    }
                }
                ContentsPane {
                    title: "Contents";
                    focused: focus-pane == 1;
                    rows: content-rows;
                    selected: content-selected;
                    width: contents-width;
                    horizontal-stretch: 0;
                    row-clicked(i) => { content-row-clicked(i); }
                    row-ctrl-clicked(i) => { content-row-ctrl-clicked(i); }
                    row-shift-clicked(i) => { content-row-shift-clicked(i); }
                    rows-marqueed(from, to) => { content-rows-marqueed(from, to); }
                    row-double-clicked(i) => { content-row-double-clicked(i); }
                    open-requested => { content-open-requested(); }
                    rename-requested => { content-rename-requested(); }
                    copy-requested => { content-copy-requested(); }
                    delete-requested => { content-delete-requested(); }
                    extract-requested => { content-extract-requested(); }
                    extract-enabled: content-is-archive;
                    prompt-text: content-prompt-text;
                    prompt-row: content-prompt-row;
                    prompt-editable: content-prompt-editable;
                    sort-column: content-sort-column;
                    sort-ascending: content-sort-ascending;
                    sort-requested(c) => { content-sort-requested(c); }
                    new-folder-requested => { new-folder-requested(); }
                    new-file-requested => { new-file-requested(); }
                }
                Splitter {
                    dragged(delta) => {
                        contents-width = clamp(contents-width + delta, 200px, root.width - folders-width - 160px);
                    }
                }
                Rectangle {
                    horizontal-stretch: 1;
                    border-width: 1px;
                    border-color: focus-pane == 2 ? Theme.accent : Theme.border;
                    VerticalLayout {
                        Text {
                            text: "File";
                            font-weight: 700;
                            color: focus-pane == 2 ? Theme.accent : Theme.heading-text;
                            height: 22px;
                            horizontal-alignment: center;
                        }
                        // A picture, for the types that are one, above the
                        // text the plugin also supplies.
                        if file-has-graphic: Rectangle {
                            // A fixed band rather than a share of the pane:
                            // deriving it from the parent closes a layout
                            // binding loop, since the parent sizes to its
                            // children.
                            height: 220px;
                            Image {
                                source: file-graphic;
                                image-fit: contain;
                                width: parent.width - 8px;
                                height: 212px;
                            }
                        }
                        view := ScrollView {
                            Text {
                                text: file-text;
                                color: Palette.foreground;
                                wrap: word-wrap;
                                // Both needed: an element with no `x`/`y` is
                                // centred in its parent, so without these a
                                // short preview floats in the middle of the
                                // pane instead of starting at the top.
                                x: 4px;
                                y: 4px;
                                width: view.visible-width - 8px;
                            }
                        }
                    }
                }
            }
            Text {
                text: status-text;
                color: Palette.foreground;
                height: 22px;
                x: 4px;
                vertical-alignment: center;
            }
        }

        // The open menu's dropdown, and a full-window catcher behind it so a
        // click anywhere else closes the menu. Declared after the panes so
        // they draw over them.
        if open-menu >= 0: TouchArea {
            width: 100%;
            height: 100%;
            clicked => { open-menu = -1; }
        }

        if open-menu == 0: Rectangle {
            x: 4px;
            y: 24px;
            width: 210px;
            height: 6 * menu-item-h;
            background: Theme.panel;
            border-width: 1px;
            border-color: Theme.border;
            VerticalLayout {
                ContextMenuItem {
                    label: "New Folder";
                    shortcut: "Ctrl+Shift+N";
                    item-height: menu-item-h;
                    activated => { open-menu = -1; new-folder-requested(); }
                }
                ContextMenuItem {
                    label: "New File";
                    shortcut: "Ctrl+N";
                    item-height: menu-item-h;
                    activated => { open-menu = -1; new-file-requested(); }
                }
                ContextMenuItem {
                    label: "Open";
                    item-enabled: has-selection;
                    item-height: menu-item-h;
                    activated => { open-menu = -1; content-open-requested(); }
                }
                ContextMenuItem {
                    label: "Rename";
                    shortcut: "F2";
                    item-enabled: has-selection;
                    item-height: menu-item-h;
                    activated => { open-menu = -1; content-rename-requested(); }
                }
                ContextMenuItem {
                    label: "Delete";
                    shortcut: "Del";
                    item-enabled: has-selection;
                    item-height: menu-item-h;
                    activated => { open-menu = -1; delete-requested(); }
                }
                ContextMenuItem {
                    label: "Exit";
                    item-height: menu-item-h;
                    activated => { open-menu = -1; quit-requested(); }
                }
            }
        }

        if open-menu == 1: Rectangle {
            x: 44px;
            y: 24px;
            width: 200px;
            height: 5 * menu-item-h;
            background: Theme.panel;
            border-width: 1px;
            border-color: Theme.border;
            VerticalLayout {
                ContextMenuItem {
                    label: "Undo";
                    shortcut: "Ctrl+Z";
                    item-height: menu-item-h;
                    activated => { open-menu = -1; undo-requested(); }
                }
                ContextMenuItem {
                    label: "Cut";
                    shortcut: "Ctrl+X";
                    item-enabled: has-selection;
                    item-height: menu-item-h;
                    activated => { open-menu = -1; clipboard-cut-requested(); }
                }
                ContextMenuItem {
                    label: "Copy";
                    shortcut: "Ctrl+C";
                    item-enabled: has-selection;
                    item-height: menu-item-h;
                    activated => { open-menu = -1; clipboard-copy-requested(); }
                }
                ContextMenuItem {
                    label: "Paste";
                    shortcut: "Ctrl+V";
                    item-enabled: can-paste;
                    item-height: menu-item-h;
                    activated => { open-menu = -1; clipboard-paste-requested(); }
                }
                ContextMenuItem {
                    label: "Select All";
                    shortcut: "Ctrl+A";
                    item-height: menu-item-h;
                    activated => { open-menu = -1; select-all-requested(); }
                }
            }
        }

        if open-menu == 2: Rectangle {
            x: 88px;
            y: 24px;
            width: 210px;
            height: 6 * menu-item-h;
            background: Theme.panel;
            border-width: 1px;
            border-color: Theme.border;
            VerticalLayout {
                ContextMenuItem {
                    label: "Refresh";
                    shortcut: "F5";
                    item-height: menu-item-h;
                    activated => { open-menu = -1; refresh-requested(); }
                }
                ContextMenuItem {
                    label: "Up One Level";
                    shortcut: "Backspace";
                    item-height: menu-item-h;
                    activated => { open-menu = -1; parent-requested(); }
                }
                ContextMenuItem {
                    label: "Sort by Name";
                    item-height: menu-item-h;
                    activated => { open-menu = -1; content-sort-requested(0); }
                }
                ContextMenuItem {
                    label: "Sort by Size";
                    item-height: menu-item-h;
                    activated => { open-menu = -1; content-sort-requested(1); }
                }
                ContextMenuItem {
                    label: "Sort by Type";
                    item-height: menu-item-h;
                    activated => { open-menu = -1; content-sort-requested(2); }
                }
                ContextMenuItem {
                    label: "Sort by Modified";
                    item-height: menu-item-h;
                    activated => { open-menu = -1; content-sort-requested(3); }
                }
            }
        }

        if open-menu == 3: Rectangle {
            x: 136px;
            y: 24px;
            width: 200px;
            height: 1 * menu-item-h;
            background: Theme.panel;
            border-width: 1px;
            border-color: Theme.border;
            VerticalLayout {
                ContextMenuItem {
                    label: "About RepoSphereExplorer";
                    item-height: menu-item-h;
                    activated => { open-menu = -1; about-requested(); }
                }
            }
        }
    }
}
