import { ScrollView, Button } from "std-widgets.slint";

component Pane inherits Rectangle {
    in property <string> title;
    in property <bool> focused;
    in property <[string]> rows;
    in property <int> selected;
    // Contents-pane rows are drag sources; folders-pane rows are drop
    // targets. Never both, per the work order's pane-to-pane-only scope.
    in property <bool> drag-source: false;
    in property <bool> drop-target: false;
    callback row-clicked(int);
    callback row-double-clicked(int);
    callback row-dropped(string, int, bool);

    border-width: 1px;
    border-color: focused ? #e5c07b : #555555;

    VerticalLayout {
        Text {
            text: title;
            font-weight: 700;
            color: focused ? #e5c07b : #cccccc;
            height: 22px;
            horizontal-alignment: center;
        }
        ScrollView {
            VerticalLayout {
                alignment: start;
                for row[i] in rows: Rectangle {
                    background: i == selected ? #3a6ea5 : transparent;
                    border-width: (drop-target && dropArea.has-drag) ? 2px : 0px;
                    border-color: #e5c07b;
                    height: 20px;
                    Text {
                        text: row;
                        color: i == selected ? white : #dddddd;
                        vertical-alignment: center;
                        x: 4px;
                    }
                    TouchArea {
                        width: 100%;
                        height: 100%;
                        clicked => { row-clicked(i); }
                        double-clicked => { row-double-clicked(i); }
                    }
                    DragArea {
                        width: 100%;
                        height: 100%;
                        allow-move: drag-source;
                        allow-copy: drag-source;
                        data: "\{i}";
                    }
                    dropArea := DropArea {
                        width: 100%;
                        height: 100%;
                        can-drop(event) => {
                            drop-target ? event.proposed-action : DragAction.none
                        }
                        dropped(event) => {
                            if drop-target {
                                row-dropped(event.data, i, event.proposed-action == DragAction.copy);
                            }
                            drop-target ? event.proposed-action : DragAction.none
                        }
                    }
                }
            }
        }
    }
}

export component MainWindow inherits Window {
    title: "RepoSphereExplorer";
    preferred-width: 1000px;
    preferred-height: 600px;

    in property <[string]> folder-rows;
    in property <int> folder-selected;
    in property <[string]> content-rows;
    in property <int> content-selected;
    in property <string> file-text;
    in property <string> status-text;
    in property <int> focus-pane;

    callback folder-row-clicked(int);
    callback folder-row-double-clicked(int);
    callback content-row-clicked(int);
    callback content-row-double-clicked(int);
    callback cancel-requested();
    callback delete-requested();
    callback return-pressed();
    callback backspace-pressed();
    callback key-text(string);
    callback parent-requested();
    callback new-folder-requested();
    callback content-dropped-on-folder(string, int, bool);

    forward-focus: key-scope;

    key-scope := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                cancel-requested();
            } else if (event.text == Key.Delete) {
                delete-requested();
            } else if (event.text == Key.Return) {
                return-pressed();
            } else if (event.text == Key.Backspace) {
                backspace-pressed();
            } else if (event.text == Key.UpArrow && event.modifiers.alt) {
                parent-requested();
            } else if (event.modifiers.control && event.modifiers.shift && (event.text == "n" || event.text == "N")) {
                new-folder-requested();
            } else {
                key-text(event.text);
            }
            accept
        }

        VerticalLayout {
            HorizontalLayout {
                height: 28px;
                Button {
                    text: "Up";
                    clicked => { parent-requested(); }
                }
            }
            HorizontalLayout {
                spacing: 2px;
                Pane {
                    title: "Folders";
                    focused: focus-pane == 0;
                    rows: folder-rows;
                    selected: folder-selected;
                    drop-target: true;
                    horizontal-stretch: 25;
                    row-clicked(i) => { folder-row-clicked(i); }
                    row-double-clicked(i) => { folder-row-double-clicked(i); }
                    row-dropped(source, dest, is-copy) => { content-dropped-on-folder(source, dest, is-copy); }
                }
                Pane {
                    title: "Contents";
                    focused: focus-pane == 1;
                    rows: content-rows;
                    selected: content-selected;
                    drag-source: true;
                    horizontal-stretch: 35;
                    row-clicked(i) => { content-row-clicked(i); }
                    row-double-clicked(i) => { content-row-double-clicked(i); }
                }
                Rectangle {
                    horizontal-stretch: 40;
                    border-width: 1px;
                    border-color: focus-pane == 2 ? #e5c07b : #555555;
                    VerticalLayout {
                        Text {
                            text: "File";
                            font-weight: 700;
                            color: focus-pane == 2 ? #e5c07b : #cccccc;
                            height: 22px;
                            horizontal-alignment: center;
                        }
                        ScrollView {
                            Text {
                                text: file-text;
                                wrap: word-wrap;
                                x: 4px;
                            }
                        }
                    }
                }
            }
            Text {
                text: status-text;
                height: 22px;
                x: 4px;
                vertical-alignment: center;
            }
        }
    }
}
