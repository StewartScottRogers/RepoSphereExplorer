import { ScrollView, Button } from "std-widgets.slint";

component Pane inherits Rectangle {
    in property <string> title;
    in property <bool> focused;
    in property <[string]> rows;
    in property <int> selected: -1;
    in property <[bool]> marks: [];
    callback row-clicked(int, bool, bool);
    callback row-double-clicked(int);

    border-width: 1px;
    border-color: focused ? #e5c07b : #555555;

    VerticalLayout {
        Text {
            text: title;
            font-weight: 700;
            color: focused ? #e5c07b : #cccccc;
            height: 22px;
            horizontal-alignment: center;
        }
        ScrollView {
            VerticalLayout {
                alignment: start;
                for row[i] in rows: Rectangle {
                    background: marks[i] || i == selected ? #3a6ea5 : transparent;
                    height: 20px;
                    Text {
                        text: row;
                        color: marks[i] || i == selected ? white : #dddddd;
                        vertical-alignment: center;
                        x: 4px;
                    }
                    TouchArea {
                        width: 100%;
                        height: 100%;
                        pointer-event(event) => {
                            if (event.kind == PointerEventKind.up && event.button == PointerEventButton.left) {
                                row-clicked(i, event.modifiers.control, event.modifiers.shift);
                            }
                        }
                        double-clicked => { row-double-clicked(i); }
                    }
                }
            }
        }
    }
}

export component MainWindow inherits Window {
    title: "RepoSphereExplorer";
    preferred-width: 1000px;
    preferred-height: 600px;

    in property <[string]> folder-rows;
    in property <int> folder-selected;
    in property <[string]> content-rows;
    in property <[bool]> content-marks;
    in property <string> file-text;
    in property <string> status-text;
    in property <int> focus-pane;

    callback folder-row-clicked(int);
    callback folder-row-double-clicked(int);
    callback content-row-clicked(int, bool, bool);
    callback content-row-double-clicked(int);
    callback cancel-requested();
    callback delete-requested();
    callback return-pressed();
    callback backspace-pressed();
    callback key-text(string);
    callback parent-requested();
    callback select-all-requested();

    forward-focus: key-scope;

    key-scope := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                cancel-requested();
            } else if (event.text == Key.Delete) {
                delete-requested();
            } else if (event.text == Key.Return) {
                return-pressed();
            } else if (event.text == Key.Backspace) {
                backspace-pressed();
            } else if (event.text == Key.UpArrow && event.modifiers.alt) {
                parent-requested();
            } else if (event.text == "a" && event.modifiers.control) {
                select-all-requested();
            } else {
                key-text(event.text);
            }
            accept
        }

        VerticalLayout {
            HorizontalLayout {
                height: 28px;
                Button {
                    text: "Up";
                    clicked => { parent-requested(); }
                }
            }
            HorizontalLayout {
                spacing: 2px;
                Pane {
                    title: "Folders";
                    focused: focus-pane == 0;
                    rows: folder-rows;
                    selected: folder-selected;
                    horizontal-stretch: 25;
                    row-clicked(i, ctrl, shift) => { folder-row-clicked(i); }
                    row-double-clicked(i) => { folder-row-double-clicked(i); }
                }
                Pane {
                    title: "Contents";
                    focused: focus-pane == 1;
                    rows: content-rows;
                    marks: content-marks;
                    horizontal-stretch: 35;
                    row-clicked(i, ctrl, shift) => { content-row-clicked(i, ctrl, shift); }
                    row-double-clicked(i) => { content-row-double-clicked(i); }
                }
                Rectangle {
                    horizontal-stretch: 40;
                    border-width: 1px;
                    border-color: focus-pane == 2 ? #e5c07b : #555555;
                    VerticalLayout {
                        Text {
                            text: "File";
                            font-weight: 700;
                            color: focus-pane == 2 ? #e5c07b : #cccccc;
                            height: 22px;
                            horizontal-alignment: center;
                        }
                        ScrollView {
                            Text {
                                text: file-text;
                                wrap: word-wrap;
                                x: 4px;
                            }
                        }
                    }
                }
            }
            Text {
                text: status-text;
                height: 22px;
                x: 4px;
                vertical-alignment: center;
            }
        }
    }
}
