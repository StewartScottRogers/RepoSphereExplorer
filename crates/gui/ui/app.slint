import { ScrollView, Palette } from "std-widgets.slint";
import { Theme, Zoom } from "theme.slint";
export { Theme, Zoom }
import { CertificateRow, ColouredRun, ContentRow, FactRow, FolderRow, PaneMenuRow, ShortcutRow, SwitcherRow } from "types.slint";
export { CertificateRow, ColouredRun, ContentRow, FactRow, FolderRow, PaneMenuRow, ShortcutRow, SwitcherRow }
export { CodeEditorHarness } from "code_editor.slint";
import {
    ChromeEdge, CommandButton, CommandSeparator, ContextMenuItem, Crumb, MenuTitle, NavButton,
    Splitter, StatusLink,
} from "widgets.slint";
import { FoldersPane } from "panes/folders_pane.slint";
import { ContentsPane } from "panes/contents_pane.slint";
import { ToolSlot } from "panes/tool_slot.slint";


export component MainWindow inherits Window {
    // #617: the main window is titled plainly; a popped-out one is titled
    // for the one pane it holds, so it is usable found on its own in
    // Alt+Tab or the taskbar.
    in property <string> window-title: "Repos Explorer";
    title: root.window-title;
    // The window icon: the title bar, the taskbar and Alt+Tab. The same
    // drawing the Windows binaries carry as a resource, so a window and a
    // shortcut to it show one picture.
    //
    // Declared here rather than handed to the window from Rust. An image a
    // running program builds carries no cache key, and Slint's window adapter
    // applies an icon only when its key differs from the one it is already
    // holding - so an icon set at run time is compared against the empty one,
    // found equal, and silently dropped. A `@image-url` is embedded at build
    // time and does have a key.
    //
    // Named, rather than bound straight to `icon`, so a test can ask the
    // window what it was given: the `icon` of a `Window` is not readable
    // from the generated Rust.
    out property <image> window-icon: @image-url("../../../assets/RepoSphereExplorer.svg");
    icon: root.window-icon;
    preferred-width: 1000px;
    preferred-height: 600px;
    background: Palette.background;
    // Windows' UI font. Slint falls back to the platform default wherever
    // it is not installed, so this costs nothing on other systems.
    default-font-family: "Segoe UI";
    // #586: every `Text` below that sets no `font-size` of its own - which
    // is nearly all of them - inherits this, so `Zoom.factor` scales the
    // three panes, the address bar, the menus, the command bar and the
    // status bar in one place. The handful that do set their own size
    // (the code editor, the coloured preview) multiply it by the same
    // factor explicitly.
    default-font-size: 12px * Zoom.factor;
    // Named so a test can read it back, the same reason `window-icon`
    // above is: `default-font-size` itself is a built-in `Window`
    // property with no generated getter.
    out property <length> zoomed-font-size: root.default-font-size;

    // #586: Ctrl+Plus/Ctrl+=, Ctrl+Minus and Ctrl+0, fired from the View
    // menu below too.
    callback zoom-in-requested();
    callback zoom-out-requested();
    callback zoom-reset-requested();

    // #721: GUIDANCE.md §2.3's macOS behaviour profile - Command in
    // place of Control for `key-scope`'s bindings below, decided once in
    // Rust (`App::mac_profile`) and read here as one flag.
    in property <bool> mac-profile: false;
    // #721: Space's quick look over the selected contents row, toggled
    // in `App::handle_key_text` and shown as a modest overlay near the
    // bottom of this file.
    in property <bool> quick-look-open: false;
    in property <string> quick-look-name;
    callback quick-look-close-requested();

    in property <[FolderRow]> folder-rows;
    in property <int> folder-selected;
    in property <[ContentRow]> content-rows;
    in property <int> content-selected;
    in property <string> file-text;
    // The File pane's fact table (#576), drawn in place of `file-text`
    // whenever a plugin offers one - a working copy's provider, branch,
    // tracking and remote, which used to be sentences `file-text` wrapped
    // across five lines at the pane's default width.
    in property <[FactRow]> file-facts;
    // The selected working copy's README (#584): its file name, empty when
    // there is none, which both hides the whole section and is what the
    // Open README link selects in Contents when clicked. `file-readme-title`
    // is its first heading, or the bare word "README" when it has none or
    // could not be read; `file-readme-excerpt` is its opening paragraphs,
    // empty in that same case.
    in property <string> file-readme-name;
    in property <string> file-readme-title;
    in property <string> file-readme-excerpt;
    callback file-readme-open-requested();
    // The File pane's "Worktree of"/"Submodule of" line (#587): the clone a
    // worktree shares, or the outer working copy pinning a submodule.
    // Empty when the selection has neither, which hides the line.
    // `file-related-repository-linked` is false only for a worktree whose
    // clone is gone, where there is nowhere to send the click.
    in property <string> file-related-repository-label;
    in property <bool> file-related-repository-linked;
    callback file-related-repository-open-requested();
    // The views the previewed type offers, and which one is showing. A type
    // offering one view gets no switcher, so it looks as it always did.
    in property <[string]> file-views;
    in property <int> file-view-index;
    callback file-view-selected(int);
    // The strip above the File pane: the plugin's views and then the way
    // in to the editor. Built in Rust so the pane does not have to know
    // which is which.
    in property <[string]> file-tabs;
    in property <int> file-tab-index;
    callback file-tab-selected(int);
    // The tool slot's picker (#616): the active tool's own frame title,
    // the titles of every tool that applies to the selection (empty
    // unless there is more than one, which keeps the picker hidden with
    // only the editor registered), and whether the active tool is the
    // editor - false only for a tool with a view of its own, none of
    // which exist yet beyond a window test's.
    in property <string> active-tool-title: "File";
    in property <[string]> tool-titles;
    in property <int> tool-index;
    callback tool-selected(int);
    in property <bool> tool-showing-editor: true;
    // The Certificates tool (#622): its own table, above the editor's own
    // properties since it draws in the same slot. View > Certificates
    // opens it for the whole Repos Directory regardless of the selection.
    in property <bool> tool-showing-certificates;
    in property <[CertificateRow]> certificate-rows;
    in property <string> certificates-summary-line;
    in property <string> certificates-private-key-line;
    in property <bool> certificates-private-keys-shown;
    in property <[string]> certificates-private-key-files;
    in property <bool> certificates-loading;
    in property <int> certificates-sort-column;
    in property <bool> certificates-sort-ascending;
    callback certificates-sort-requested(int);
    callback certificate-row-activated(int);
    callback certificates-private-keys-toggled();
    callback certificates-requested();
    // The editor's own commands, shown in the File pane while it is
    // open. The window's toolbar is about managing files, which is not
    // where anybody looks while typing into one.
    in property <bool> edit-modified;
    in property <bool> edit-can-undo;
    in property <bool> edit-can-redo;
    in property <bool> edit-has-selection;
    in property <int> edit-line;
    in property <int> edit-column;
    callback edit-undo-requested();
    callback edit-redo-requested();
    callback edit-cut-requested();
    callback edit-copy-requested();
    callback edit-paste-requested();
    // A picture for the previewed file, when its type is one.
    in property <image> file-graphic;
    in property <bool> file-has-graphic;
    in property <string> status-text;
    in property <int> focus-pane;
    // #617: which panes this window holds. All three for the main window;
    // exactly one for a window a pane has popped out into - the other two
    // are hidden here rather than drawn empty, so the remaining pane(s)
    // and splitter(s) close the gap.
    in property <bool> show-folders-pane: true;
    in property <bool> show-contents-pane: true;
    in property <bool> show-file-pane: true;
    // Whether this window is the main one, rather than a pane's own
    // popped-out window - each pane's frame reads this to decide whether
    // it offers to pop out or to dock back.
    in property <bool> is-main-window: true;
    // 0 Folders, 1 Contents, 2 File - the pane a pop-out or dock button,
    // or a View menu row below, names.
    callback pop-out-requested(int);
    callback dock-requested(int);
    // The View menu's Pop Out and Dock lists: every docked pane, and every
    // popped-out one, built in Rust from which panes are currently out.
    in property <[PaneMenuRow]> pop-out-rows;
    in property <[PaneMenuRow]> dock-rows;
    // #618: docks every popped-out pane back at once (the empty main
    // window's own "Dock All"), and brings the main window back after it
    // was closed while panes were still popped out (every popped-out
    // window's View menu).
    callback dock-all-requested();
    callback show-main-window-requested();
    // #619: pins the File pane's own popped-out window to what it is
    // showing, so it keeps that instead of following the shared selection
    // - offered only there, never on the main window or a Folders/Contents
    // pop-out.
    in property <bool> pinned: false;
    callback pin-requested();
    callback unpin-requested();

    callback folder-row-clicked(int, length);
    callback folder-row-double-clicked(int);
    callback content-row-clicked(int);
    callback content-row-ctrl-clicked(int);
    callback content-row-shift-clicked(int);
    callback content-rows-marqueed(int, int);
    callback content-row-double-clicked(int);
    callback content-open-requested();
    callback content-rename-requested();
    callback content-copy-requested();
    callback content-delete-requested();
    callback content-extract-requested();
    callback cancel-requested();
    callback delete-requested();
    callback return-pressed();
    callback backspace-pressed();
    callback key-text(string);
    callback parent-requested();
    callback new-folder-requested();
    callback new-file-requested();
    callback selection-moved(int);
    // The same movements with Shift held: the range grows to where the
    // key would have moved, rather than the selection jumping there.
    callback selection-extended(int);
    callback edge-extended(int);
    callback pane-cycled(int);
    // Whether the selected contents row previewed as an archive.
    in property <bool> content-is-archive;
    // The prompt a pending operation is waiting on, and the row it applies to.
    in property <string> content-prompt-text;
    in property <int> content-prompt-row: -1;
    in property <bool> content-prompt-editable;
    // What the command bar and menus enable from.
    in property <bool> has-selection;
    in property <bool> can-paste;
    callback quit-requested();
    // File > Repos Directory...: settles where every launch opens.
    callback repos-root-requested();
    callback about-requested();
    // Which contents column is sorted on, and which way.
    in property <int> content-sort-column;
    in property <bool> content-sort-ascending;
    callback content-sort-requested(int);
    // Address bar and history navigation.
    in property <[string]> breadcrumbs;
    // The browsed folder as one string. Only for noticing that it changed;
    // what is drawn comes from `breadcrumbs`.
    in property <string> address-path;
    in property <bool> can-go-back;
    in property <bool> can-go-forward;
    in property <bool> can-go-up;
    // The address bar as a text field, while a path is being typed.
    in property <string> path-input;
    in property <bool> editing-path;
    in property <image> location-icon;
    // The file pane as an editor, for the types whose plugin can edit them.
    in property <bool> editing-file;
    // The Text view's lines, each split into coloured runs. Empty when
    // there is nothing to colour - the Preview is showing, the plugin
    // describes no language, or the file carries no text - and the plain
    // `Text` below is drawn instead.
    in property <[[ColouredRun]]> file-lines;
    in property <bool> can-edit;
    in property <bool> can-open;
    in property <string> web-provider;
    callback open-web-requested();
    // Handing a selected folder to a program the user already has (#581).
    // The Contents pane's row menu and the File menu share these - both
    // act on the Contents pane's selection, the same as Open, Rename and
    // Delete already do - while the Folders pane's row menu gets its own,
    // acting on whichever row was right-clicked there instead.
    in property <bool> editor-available;
    in property <bool> content-remote-address-copyable;
    in property <string> file-manager-label: "Show in File Explorer";
    callback open-terminal-requested();
    callback open-in-editor-requested();
    callback copy-path-requested();
    callback copy-remote-address-requested();
    callback show-in-file-manager-requested();
    in property <bool> folder-editor-available;
    in property <bool> folder-remote-address-copyable;
    callback folder-open-terminal-requested();
    callback folder-open-in-editor-requested();
    callback folder-copy-path-requested();
    callback folder-copy-remote-address-requested();
    callback folder-show-in-file-manager-requested();
    in property <bool> showing-found;
    // View > All Repositories (#591): every working copy found up to three
    // folder levels below the Repos Directory. `showing-all-repositories`
    // is what tells the Contents pane's columns and the Folders tree's own
    // entry apart from an ordinary listing; `all-repositories-requested`
    // opens it, the way `switcher-open-requested` opens the switcher.
    in property <bool> showing-all-repositories;
    callback all-repositories-requested();
    // The Folders tree's own All Repositories entry draws the same folder
    // icon a plain folder's row does - a scan below the root is not itself
    // a working copy, so it never earns the branch mark one carries.
    in property <image> all-repositories-icon;
    // Whether the current listing holds a file, so the Size column - blank
    // on every row otherwise - is drawn only once there is a size to show
    // (#578).
    in property <bool> content-size-column-visible: true;
    // Whether the current listing holds a repository, so the Modified
    // column's header reads "Last activity" (#588).
    in property <bool> content-holds-repository;
    callback find-requested();
    // The Contents pane's filter field and the status bar's two links
    // (#582): a name typed narrows the listing live, the changed count is
    // a link that does the same for uncommitted changes, and "clear"
    // drops both.
    in property <string> filter-text;
    in property <bool> filter-focused;
    callback filter-focus-requested();
    in property <string> status-changed-label;
    // The fuller words a screen reader speaks for the link above (#629);
    // kept apart from `status-changed-label` since that one stays terse
    // for sighted eyes.
    in property <string> status-changed-accessible-label;
    in property <bool> status-show-clear-link;
    // Whether Tab has moved the keyboard onto whichever status-bar link
    // is showing (#629), so both draw their focus ring off the one flag -
    // only one of the two ever shows at a time.
    in property <bool> status-link-focused;
    callback status-changed-link-clicked();
    // Tab from the Contents pane (#629): a no-op unless a status-bar link
    // is actually showing, decided in Rust the same way
    // `message-focus-requested` already is.
    callback status-link-focus-requested();
    // Help > Keyboard shortcuts (#585): the table's rows, grouped and
    // labelled for this platform once by `shortcuts::rows` rather than on
    // every sync, since the list does not change while the window runs.
    in property <[ShortcutRow]> shortcut-rows;
    // `in-out` rather than private, so a test can ask whether F1 opened
    // the sheet and whether Escape closed it (#585's acceptance check 3).
    in-out property <bool> shortcuts-open: false;
    // Ctrl+P / Cmd+P's Go to Repository switcher (#590): Rust owns every
    // keystroke that reaches it (rule 14), so unlike `shortcuts-open`
    // these are `in`, driven by `Mode::Switcher` rather than by the
    // markup - and `switcher-open-requested` is the one that opens it,
    // since opening also seeds `App`'s own state, which a plain
    // `in-out` flag flipped from here could not do.
    in property <bool> switcher-open;
    in property <string> switcher-query;
    in property <[SwitcherRow]> switcher-rows;
    callback switcher-open-requested();
    callback switcher-row-clicked(int);
    callback status-clear-filter-clicked();
    // Ctrl+Shift+U (#629): toggles the changed-only filter above from
    // anywhere in the window, so a reader who has not tabbed to the link
    // itself still has a keyboard way to reach it.
    callback changed-filter-toggled();
    // The Contents pane's centred message (#592), threaded down into
    // `contents-pane` below.
    in property <string> message-title;
    in property <string> message-detail;
    in property <bool> message-show-retry;
    in property <bool> message-show-choose;
    in property <bool> message-show-clear-filter;
    in property <int> message-focus-index: -1;
    callback message-focus-requested(int);
    in-out property <string> edit-text;
    // The coloured surface's half of the editor. `editing-in-colour` is
    // false for a file it cannot serve - see `editor::code_editor_suits`
    // - and the plain box below takes it instead.
    in property <bool> editing-in-colour;
    in property <[[ColouredRun]]> edit-lines;
    in property <int> edit-caret-line;
    in property <int> edit-caret-column;
    in property <int> edit-selection-start-line: -1;
    in property <int> edit-selection-start-column;
    in property <int> edit-selection-end-line;
    in property <int> edit-selection-end-column;
    in property <int> edit-longest-line;
    // How many rows a page up or down moves by: what the pane is showing,
    // rather than a number chosen here. Measured from the File pane
    // rather than from the editor inside it, because Slint cannot name
    // an element that sits inside an `if`. The 22px is the pane heading
    // above the editor; being a row out either way costs nothing.
    // The 22px is the pane heading; the 46px is the editor's own command
    // row and the caret readout below it, which sit between the heading
    // and the text. Without them a page moved three rows further than
    // the reader could see, every time.
    out property <int> edit-visible-rows:
        floor((file-pane.height - 22px - (editing-file ? 46px : 0px)) / (16px * Zoom.factor));
    // True when the editing surface used the key. A false one falls
    // through to the window's own scope; see `key-scope` below for the
    // short list that still means something while a file is open.
    callback edit-key(string, bool, bool) -> bool;
    callback edit-pressed(int, int);
    callback edit-requested();
    callback save-requested();
    callback path-edit-requested();
    // How much of a long path is shown. Explorer hides the middle behind a
    // menu; this keeps the tail, which is the part that says where you are,
    // and expands in place when asked.
    property <int> max-crumbs: 5;
    property <bool> crumbs-expanded: false;

    // Expanding is for the path in front of the reader, not for every path
    // afterwards. Nothing put this back, so one click on the ellipsis left
    // every folder for the rest of the session drawing its full path - and
    // a long one pushes the tail, the part that says where you are, off
    // the end of the bar.
    //
    // Watched on the path rather than on `breadcrumbs`, which `sync_ui`
    // rebuilds on every timer tick: that would collapse the bar a tenth of
    // a second after the reader expanded it.
    changed address-path => {
        crumbs-expanded = false;
    }
    property <int> first-crumb: crumbs-expanded || breadcrumbs.length <= max-crumbs
        ? 0
        : breadcrumbs.length - max-crumbs;
    callback back-requested();
    callback forward-requested();
    callback breadcrumb-requested(int);
    // Windows clipboard and list navigation keys.
    callback clipboard-copy-requested();
    callback clipboard-cut-requested();
    callback clipboard-paste-requested();
    callback refresh-requested();
    callback select-all-requested();
    callback undo-requested();
    // Pane widths, moved by the splitters between them. The file pane takes
    // whatever the other two leave.
    // `in-out` so the widths can be restored at startup and read back when
    // the window closes; the splitters move them in between.
    // #586: the default, un-restored width - once a real width is
    // restored or dragged, Rust owns it outright and this binding no
    // longer applies - widens with the zoom so the default layout keeps
    // showing a whole name at every step rather than only at 100%.
    in-out property <length> folders-width: 240px * Zoom.factor;
    in-out property <length> contents-width: 470px * Zoom.factor;
    // The File pane's own floor (#577), and what a splitter drag leaves
    // Folders and Contents down to. Named rather than repeated as literals,
    // so the drag clamps below and Rust's `fit_pane_widths` cannot drift
    // apart from what is actually drawn.
    property <length> min-folders-width: 120px;
    property <length> min-contents-width: 200px;
    property <length> min-file-pane-width: 280px;
    // The two splitters, 5px each - width neither pane nor the File pane
    // ever gets to claim.
    property <length> splitters-width: 10px;
    // Each pane's scroll offset, so the front end can bring the selected row
    // into view. Two-way: the user scrolls with the wheel and the scrollbar
    // too, and whatever they left it at is where the next adjustment starts.
    in-out property <length> folders-scroll-y;
    in-out property <length> content-scroll-y;
    // How much of each listing is on screen, which decides whether the
    // selected row needs bringing into view at all.
    out property <length> folders-viewport-height: folders-pane.viewport-height;
    out property <length> content-viewport-height: contents-pane.viewport-height;
    // What colour each pane's selection is actually drawn in, so a window
    // test can ask rather than re-deriving it from `focus-pane` (#575).
    out property <brush> folders-selection-colour: folders-pane.selection-colour;
    out property <brush> contents-selection-colour: contents-pane.selection-colour;
    // What colour each pane's `PaneFrame` border is actually drawn in, so
    // a window test can ask whether the frame's focused state follows
    // `focus-pane` rather than trusting the binding by inspection.
    out property <brush> folders-frame-border-colour: folders-pane.border-color;
    out property <brush> contents-frame-border-colour: contents-pane.border-color;
    out property <brush> file-frame-border-colour: file-pane.border-color;
    // Which menu is open: -1 none, then File, Edit, View, Help. A menu is a
    // property rather than a `PopupWindow` so it can be sized, placed and
    // clicked like any other element.
    property <int> open-menu: -1;
    property <length> menu-item-h: 24px * Zoom.factor;
    callback edge-requested(int);

    // #721: the one place `key-scope` below decides whether a binding's
    // Control is held as Control or as Command - GUIDANCE.md §2.3's
    // macOS behaviour profile. Every Ctrl-or-Cmd condition asks this
    // rather than reading `event.modifiers.control` itself, so the
    // profile is one function, not a `cfg!` in each of them.
    pure function primary-modifier(control: bool, meta: bool) -> bool {
        mac-profile ? meta : control
    }

    forward-focus: key-scope;

    // The editing surface takes the keyboard when it opens, and its
    // focus scope is destroyed when it closes - leaving Slint's focus on
    // an item that no longer exists and every key after it delivered to
    // nobody. The whole window's keyboard was dead after a save or a
    // close until the window was deactivated and brought back.
    changed editing-file => {
        if (!editing-file) { key-scope.focus(); }
    }

    // And the same when the reader clicks another pane while the editor
    // is open: the pane they clicked is drawn focused, so the keyboard
    // has to follow it rather than staying in a surface that is no
    // longer the thing they are looking at.
    changed focus-pane => {
        if (editing-file && focus-pane != 2) { key-scope.focus(); }
    }

    key-scope := FocusScope {
        key-pressed(event) => {
            // F1 and the sheet's own Escape take the keyboard ahead of
            // everything below, editing included - a reader typing into a
            // file can still ask what the keys mean, and Escape closes
            // the sheet rather than reaching whatever Escape would
            // otherwise have cancelled.
            if (root.shortcuts-open) {
                if (event.text == Key.Escape) {
                    root.shortcuts-open = false;
                }
                return accept;
            }
            // Space's quick look (#721, GUIDANCE.md §2.3) takes the
            // keyboard the same way, once it is open: Escape closes it,
            // and Space forwards to `key-text` so `App::handle_key_text`'s
            // own toggle closes it too - the same key that opened it.
            if (root.quick-look-open) {
                if (event.text == Key.Escape) {
                    quick-look-close-requested();
                } else if (event.text == " ") {
                    key-text(event.text);
                }
                return accept;
            }
            if (event.text == Key.F1 || (primary-modifier(event.modifiers.control, event.modifiers.meta) && (event.text == "/"))) {
                root.shortcuts-open = true;
                return accept;
            }
            // Zoom (#586) works over every pane, editing included, the same
            // as F1 above - a reader part-way through typing a file should
            // still be able to make the text bigger.
            if (primary-modifier(event.modifiers.control, event.modifiers.meta) && (event.text == "+" || event.text == "=")) {
                zoom-in-requested();
                return accept;
            }
            if (primary-modifier(event.modifiers.control, event.modifiers.meta) && event.text == "-") {
                zoom-out-requested();
                return accept;
            }
            if (primary-modifier(event.modifiers.control, event.modifiers.meta) && event.text == "0") {
                zoom-reset-requested();
                return accept;
            }
            // Ctrl+Shift+U (#629) toggles the changed-only filter from
            // anywhere in the window, editing included, the same as F1
            // and Zoom above.
            if (primary-modifier(event.modifiers.control, event.modifiers.meta) && event.modifiers.shift && (event.text == "u" || event.text == "U")) {
                changed-filter-toggled();
                return accept;
            }
            // A key that gets here while the editor has the keyboard is
            // one the editing surface did not want. Four of them still
            // mean something; the rest are the Contents pane's - rename,
            // new file, the arrows, the type-ahead - and must not fire
            // into a file somebody is in the middle of typing.
            //
            // Once the reader clicks another pane the file is still open
            // but the editor is no longer the focused pane, and the pane
            // they clicked has to answer its own keys - otherwise the
            // pane drawn as focused is not the one listening.
            if (editing-file && focus-pane == 2) {
                if (event.text == Key.Escape) {
                    cancel-requested();
                } else if (primary-modifier(event.modifiers.control, event.modifiers.meta) && (event.text == "s" || event.text == "S")) {
                    save-requested();
                } else if (primary-modifier(event.modifiers.control, event.modifiers.meta) && (event.text == "z" || event.text == "Z")) {
                    undo-requested();
                } else if (event.text == Key.F5) {
                    refresh-requested();
                }
                return accept;
            }
            if (event.text == Key.Escape) {
                cancel-requested();
            } else if (event.text == Key.Delete && (!root.mac-profile || event.modifiers.meta)) {
                // Plain Delete moves to Trash on Windows and Linux; the
                // macOS behaviour profile (#721, GUIDANCE.md §2.3) asks
                // Cmd+Delete instead, matching that platform's own file
                // manager - `App::status_text`/`prompt_text` name Trash
                // there too.
                delete-requested();
            } else if (event.text == Key.Return) {
                return-pressed();
            } else if (event.text == Key.Backspace) {
                backspace-pressed();
            } else if (event.text == Key.F2) {
                content-rename-requested();
            } else if (event.text == Key.Tab) {
                // Moves the Contents pane message's highlighted button
                // (#592); a no-op while no message is showing, the same
                // as Tab did here before that pane existed.
                message-focus-requested(event.modifiers.shift ? -1 : 1);
                // Moves the keyboard onto the status bar's link (#629),
                // in reading order after the Contents pane; a no-op the
                // same way when none is showing.
                status-link-focus-requested();
            } else if (event.text == Key.UpArrow && event.modifiers.alt) {
                parent-requested();
            } else if (primary-modifier(event.modifiers.control, event.modifiers.meta) && event.modifiers.shift && (event.text == "f" || event.text == "F")) {
                find-requested();
            } else if (primary-modifier(event.modifiers.control, event.modifiers.meta) && (event.text == "f" || event.text == "F")) {
                filter-focus-requested();
            } else if (primary-modifier(event.modifiers.control, event.modifiers.meta) && (event.text == "p" || event.text == "P")) {
                switcher-open-requested();
            } else if (primary-modifier(event.modifiers.control, event.modifiers.meta) && event.modifiers.shift && (event.text == "n" || event.text == "N")) {
                new-folder-requested();
            } else if (primary-modifier(event.modifiers.control, event.modifiers.meta) && (event.text == "n" || event.text == "N")) {
                new-file-requested();
            } else if (event.modifiers.alt && event.text == Key.LeftArrow) {
                back-requested();
            } else if (event.modifiers.alt && event.text == Key.RightArrow) {
                forward-requested();
            } else if (primary-modifier(event.modifiers.control, event.modifiers.meta) && (event.text == "z" || event.text == "Z")) {
                undo-requested();
            } else if (primary-modifier(event.modifiers.control, event.modifiers.meta) && (event.text == "a" || event.text == "A")) {
                select-all-requested();
            } else if (primary-modifier(event.modifiers.control, event.modifiers.meta) && (event.text == "c" || event.text == "C")) {
                clipboard-copy-requested();
            } else if (primary-modifier(event.modifiers.control, event.modifiers.meta) && (event.text == "x" || event.text == "X")) {
                clipboard-cut-requested();
            } else if (primary-modifier(event.modifiers.control, event.modifiers.meta) && (event.text == "v" || event.text == "V")) {
                clipboard-paste-requested();
            } else if (event.text == Key.F4
                || (primary-modifier(event.modifiers.control, event.modifiers.meta) && (event.text == "l" || event.text == "L"))) {
                path-edit-requested();
            } else if (primary-modifier(event.modifiers.control, event.modifiers.meta) && (event.text == "s" || event.text == "S")) {
                save-requested();
            } else if (primary-modifier(event.modifiers.control, event.modifiers.meta) && (event.text == "e" || event.text == "E")) {
                edit-requested();
            } else if (event.text == Key.F5) {
                refresh-requested();
            } else if (event.text == Key.Home) {
                if (event.modifiers.shift) { edge-extended(0); } else { edge-requested(0); }
            } else if (event.text == Key.End) {
                if (event.modifiers.shift) { edge-extended(1); } else { edge-requested(1); }
            } else if (event.text == Key.PageUp) {
                if (event.modifiers.shift) { selection-extended(-10); } else { selection-moved(-10); }
            } else if (event.text == Key.PageDown) {
                if (event.modifiers.shift) { selection-extended(10); } else { selection-moved(10); }
            } else if (event.text == Key.UpArrow) {
                if (event.modifiers.shift) { selection-extended(-1); } else { selection-moved(-1); }
            } else if (event.text == Key.DownArrow) {
                if (event.modifiers.shift) { selection-extended(1); } else { selection-moved(1); }
            } else if (event.text == Key.RightArrow) {
                pane-cycled(1);
            } else if (event.text == Key.LeftArrow) {
                pane-cycled(-1);
            } else {
                key-text(event.text);
            }
            accept
        }

        VerticalLayout {
            // Menu bar.
            Rectangle {
                height: 24px * Zoom.factor;
                background: Theme.panel;
                // The menu bar is its own strip: the command bar below is a
                // different kind of thing and should not run into it.
                ChromeEdge {
                    y: parent.height - 1px;
                }
                HorizontalLayout {
                    alignment: start;
                    file-title := MenuTitle {
                        label: "File";
                        open: open-menu == 0;
                        activated => { open-menu = open-menu == 0 ? -1 : 0; }
                    }
                    edit-title := MenuTitle {
                        label: "Edit";
                        open: open-menu == 1;
                        activated => { open-menu = open-menu == 1 ? -1 : 1; }
                    }
                    view-title := MenuTitle {
                        label: "View";
                        open: open-menu == 2;
                        activated => { open-menu = open-menu == 2 ? -1 : 2; }
                    }
                    // Go to Repository, the switcher's menu path (#590).
                    // Its own menu rather than an item under View: it is
                    // the one action that moves the reader somewhere else.
                    go-title := MenuTitle {
                        label: "Go";
                        open: open-menu == 3;
                        activated => { open-menu = open-menu == 3 ? -1 : 3; }
                    }
                    help-title := MenuTitle {
                        label: "Help";
                        open: open-menu == 4;
                        activated => { open-menu = open-menu == 4 ? -1 : 4; }
                    }
                }
            }

            // Command bar.
            Rectangle {
                height: 30px * Zoom.factor;
                background: Theme.panel;
                // The edge that ends the chrome: everything below this line
                // is content.
                ChromeEdge {
                    y: parent.height - 1px;
                }
                HorizontalLayout {
                    padding-left: 6px;
                    padding-top: 3px;
                    padding-bottom: 4px;
                    spacing: 1px;
                    alignment: start;
                    CommandButton {
                        label: web-provider == "" ? "Open on the web" : "Open on " + web-provider;
                        button-enabled: web-provider != "";
                        activated => { open-web-requested(); }
                    }
                    CommandSeparator { }
                    CommandButton {
                        label: "New folder";
                        activated => { new-folder-requested(); }
                    }
                    CommandSeparator { }
                    CommandButton {
                        label: "Rename";
                        button-enabled: has-selection;
                        activated => { content-rename-requested(); }
                    }
                    CommandButton {
                        label: "Delete";
                        button-enabled: has-selection;
                        activated => { delete-requested(); }
                    }
                    CommandSeparator { }
                    CommandButton {
                        label: "Undo";
                        activated => { undo-requested(); }
                    }
                    CommandButton {
                        label: "Refresh";
                        activated => { refresh-requested(); }
                    }
                }
            }

            // Navigation and address bar.
            Rectangle {
                height: 30px;
                background: Theme.panel;
                HorizontalLayout {
                    padding: 2px;
                    spacing: 2px;
                    NavButton {
                        // U+2190 / U+2192 / U+2191: the plain arrows.
                        glyph: "\u{2190}";
                        button-enabled: can-go-back;
                        activated => { back-requested(); }
                    }
                    NavButton {
                        glyph: "\u{2192}";
                        button-enabled: can-go-forward;
                        activated => { forward-requested(); }
                    }
                    // Back and forward are a pair - they walk one history -
                    // and up is not: it is a move, not a step backwards.
                    CommandSeparator { }
                    NavButton {
                        glyph: "\u{2191}";
                        button-enabled: can-go-up;
                        activated => { parent-requested(); }
                    }
                    Rectangle {
                        width: 6px;
                    }
                    // The address bar. Segments while browsing, a text field
                    // while a path is being typed, the way Explorer's is.
                    Rectangle {
                        horizontal-stretch: 1;
                        background: Theme.field;
                        border-width: 1px;
                        border-color: editing-path ? Theme.accent : Theme.hover;
                        border-radius: 3px;

                        // Declared first so it sits under the segments: a
                        // click that misses one lands here and starts
                        // editing, as clicking past the path in Explorer
                        // does. Later siblings take their own clicks.
                        TouchArea {
                            width: 100%;
                            height: 100%;
                            mouse-cursor: text;
                            clicked => { path-edit-requested(); }
                        }

                        if editing-path: HorizontalLayout {
                            padding-left: 6px;
                            padding-right: 6px;
                            spacing: 2px;
                            alignment: start;
                            Text {
                                text: path-input;
                                color: Palette.foreground;
                                vertical-alignment: center;
                            }
                            Rectangle {
                                width: 1px;
                                background: Theme.accent;
                                y: 4px;
                                height: parent.height - 8px;
                            }
                            Text {
                                text: "  (Enter / Esc)";
                                color: Theme.dim-text;
                                vertical-alignment: center;
                            }
                        }

                        if !editing-path: HorizontalLayout {
                            padding-left: 4px;
                            padding-right: 2px;
                            spacing: 2px;
                            alignment: start;
                            Image {
                                source: location-icon;
                                width: 16px * Zoom.factor;
                                height: 16px * Zoom.factor;
                                image-fit: contain;
                                y: (parent.height - 16px * Zoom.factor) / 2;
                            }
                            // A path longer than the bar collapses its
                            // leading segments behind this, which expands
                            // them rather than hiding them behind a menu.
                            if first-crumb > 0: Crumb {
                                label: "\u{2026}";
                                activated => { crumbs-expanded = true; }
                            }
                            for crumb[i] in breadcrumbs: HorizontalLayout {
                                if i >= first-crumb: Crumb {
                                    label: crumb;
                                    last: i == breadcrumbs.length - 1;
                                    activated => { breadcrumb-requested(i); }
                                }
                                if i >= first-crumb && i < breadcrumbs.length - 1: Text {
                                    text: "\u{203A}";
                                    color: Theme.dim-text;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }
            }
            // #618: every pane is popped out of the main window into one of
            // its own. The panes layout below collapses to nothing in this
            // case (each pane's width goes to 0), so this message and Dock
            // All button fill the gap rather than leaving it blank.
            if is-main-window && !show-folders-pane && !show-contents-pane && !show-file-pane: Rectangle {
                horizontal-stretch: 1;
                vertical-stretch: 1;
                VerticalLayout {
                    alignment: center;
                    Text {
                        text: "All panes are in their own windows";
                        horizontal-alignment: center;
                        color: Theme.dim-text;
                    }
                    HorizontalLayout {
                        alignment: center;
                        padding-top: 8px;
                        CommandButton {
                            label: "Dock All";
                            activated => { dock-all-requested(); }
                        }
                    }
                }
            }
            HorizontalLayout {
                spacing: 2px;
                folders-pane := FoldersPane {
                    title: "Folders";
                    focused: focus-pane == 0;
                    popped-out: !root.is-main-window;
                    pop-out-clicked => { pop-out-requested(0); }
                    dock-clicked => { dock-requested(0); }
                    rows: folder-rows;
                    selected: showing-all-repositories ? -1 : folder-selected;
                    all-repositories-icon: all-repositories-icon;
                    all-repositories-selected: showing-all-repositories;
                    all-repositories-clicked => { all-repositories-requested(); }
                    scroll-y <=> folders-scroll-y;
                    visible: show-folders-pane;
                    width: show-folders-pane ? folders-width : 0px;
                    horizontal-stretch: 0;
                    row-clicked(i, x) => { folder-row-clicked(i, x); }
                    row-double-clicked(i) => { folder-row-double-clicked(i); }
                    editor-available: folder-editor-available;
                    remote-address-copyable: folder-remote-address-copyable;
                    file-manager-label: file-manager-label;
                    open-terminal-requested => { folder-open-terminal-requested(); }
                    open-in-editor-requested => { folder-open-in-editor-requested(); }
                    copy-path-requested => { folder-copy-path-requested(); }
                    copy-remote-address-requested => { folder-copy-remote-address-requested(); }
                    show-in-file-manager-requested => { folder-show-in-file-manager-requested(); }
                }
                folders-splitter := Splitter {
                    visible: show-folders-pane;
                    width: show-folders-pane ? 5px : 0px;
                    dragged(delta) => {
                        folders-width = clamp(
                            folders-width + delta,
                            min-folders-width,
                            root.width - contents-width - min-file-pane-width - splitters-width);
                    }
                    double-clicked => {
                        folders-width = clamp(
                            folders-pane.fit-width,
                            min-folders-width,
                            root.width - contents-width - min-file-pane-width - splitters-width);
                    }
                }
                contents-pane := ContentsPane {
                    title: "Contents";
                    focused: focus-pane == 1;
                    popped-out: !root.is-main-window;
                    pop-out-clicked => { pop-out-requested(1); }
                    dock-clicked => { dock-requested(1); }
                    rows: content-rows;
                    selected: content-selected;
                    scroll-y <=> content-scroll-y;
                    visible: show-contents-pane;
                    width: show-contents-pane ? contents-width : 0px;
                    pane-width: contents-width;
                    horizontal-stretch: 0;
                    row-clicked(i) => { content-row-clicked(i); }
                    row-ctrl-clicked(i) => { content-row-ctrl-clicked(i); }
                    row-shift-clicked(i) => { content-row-shift-clicked(i); }
                    rows-marqueed(from, to) => { content-rows-marqueed(from, to); }
                    row-double-clicked(i) => { content-row-double-clicked(i); }
                    open-requested => { content-open-requested(); }
                    rename-requested => { content-rename-requested(); }
                    can-open: can-open;
                    web-provider: web-provider;
                    open-web-requested => { open-web-requested(); }
                    copy-requested => { content-copy-requested(); }
                    clipboard-copy-requested => { clipboard-copy-requested(); }
                    delete-requested => { content-delete-requested(); }
                    extract-requested => { content-extract-requested(); }
                    extract-enabled: content-is-archive;
                    prompt-text: content-prompt-text;
                    prompt-row: content-prompt-row;
                    prompt-editable: content-prompt-editable;
                    sort-column: showing-found || showing-all-repositories ? -1 : content-sort-column;
                    showing-found: showing-found;
                    showing-all-repositories: showing-all-repositories;
                    show-size-column: content-size-column-visible;
                    holds-repository: content-holds-repository;
                    sort-ascending: content-sort-ascending;
                    sort-requested(c) => { content-sort-requested(c); }
                    new-folder-requested => { new-folder-requested(); }
                    new-file-requested => { new-file-requested(); }
                    editor-available: editor-available;
                    remote-address-copyable: content-remote-address-copyable;
                    file-manager-label: file-manager-label;
                    open-terminal-requested => { open-terminal-requested(); }
                    open-in-editor-requested => { open-in-editor-requested(); }
                    copy-path-requested => { copy-path-requested(); }
                    copy-remote-address-requested => { copy-remote-address-requested(); }
                    show-in-file-manager-requested => { show-in-file-manager-requested(); }
                    filter-text: filter-text;
                    filter-focused: filter-focused;
                    filter-focus-requested => { filter-focus-requested(); }
                    message-title: message-title;
                    message-detail: message-detail;
                    message-show-retry: message-show-retry;
                    message-show-choose: message-show-choose;
                    message-show-clear-filter: message-show-clear-filter;
                    message-focus-index: message-focus-index;
                    message-retry-requested => { refresh-requested(); }
                    message-choose-requested => { repos-root-requested(); }
                    message-clear-filter-requested => { status-clear-filter-clicked(); }
                }
                contents-splitter := Splitter {
                    visible: show-contents-pane;
                    width: show-contents-pane ? 5px : 0px;
                    dragged(delta) => {
                        contents-width = clamp(
                            contents-width + delta,
                            min-contents-width,
                            root.width - folders-width - min-file-pane-width - splitters-width);
                    }
                }
                file-pane := ToolSlot {
                    visible: show-file-pane;
                    horizontal-stretch: show-file-pane ? 1 : 0;
                    min-width: show-file-pane ? min-file-pane-width : 0px;
                    title: active-tool-title;
                    tool-titles: tool-titles;
                    tool-index: tool-index;
                    tool-selected(i) => { tool-selected(i); }
                    tool-showing-editor: tool-showing-editor;
                    tool-showing-certificates: tool-showing-certificates;
                    certificate-rows: certificate-rows;
                    certificates-summary-line: certificates-summary-line;
                    certificates-private-key-line: certificates-private-key-line;
                    certificates-private-keys-shown: certificates-private-keys-shown;
                    certificates-private-key-files: certificates-private-key-files;
                    certificates-loading: certificates-loading;
                    certificates-sort-column: certificates-sort-column;
                    certificates-sort-ascending: certificates-sort-ascending;
                    certificates-sort-requested(column) => { certificates-sort-requested(column); }
                    certificate-row-activated(index) => { certificate-row-activated(index); }
                    certificates-private-keys-toggled => { certificates-private-keys-toggled(); }
                    focused: focus-pane == 2;
                    popped-out: !root.is-main-window;
                    pop-out-clicked => { pop-out-requested(2); }
                    dock-clicked => { dock-requested(2); }
                    pinnable: true;
                    pinned: root.pinned;
                    pin-clicked => { pin-requested(); }
                    unpin-clicked => { unpin-requested(); }
                    editing-file: editing-file;
                    edit-modified: edit-modified;
                    edit-can-undo: edit-can-undo;
                    edit-can-redo: edit-can-redo;
                    edit-has-selection: edit-has-selection;
                    edit-line: edit-line;
                    edit-column: edit-column;
                    save-requested => { save-requested(); }
                    edit-undo-requested => { edit-undo-requested(); }
                    edit-redo-requested => { edit-redo-requested(); }
                    edit-cut-requested => { edit-cut-requested(); }
                    edit-copy-requested => { edit-copy-requested(); }
                    edit-paste-requested => { edit-paste-requested(); }
                    cancel-requested => { cancel-requested(); }
                    editing-in-colour: editing-in-colour;
                    edit-lines: edit-lines;
                    edit-caret-line: edit-caret-line;
                    edit-caret-column: edit-caret-column;
                    edit-selection-start-line: edit-selection-start-line;
                    edit-selection-start-column: edit-selection-start-column;
                    edit-selection-end-line: edit-selection-end-line;
                    edit-selection-end-column: edit-selection-end-column;
                    edit-longest-line: edit-longest-line;
                    edit-key(text, shift, control) => { return edit-key(text, shift, control); }
                    edit-pressed(line, column) => { edit-pressed(line, column); }
                    edit-text <=> edit-text;
                    file-tabs: file-tabs;
                    file-tab-index: file-tab-index;
                    file-tab-selected(i) => { file-tab-selected(i); }
                    file-facts: file-facts;
                    file-related-repository-label: file-related-repository-label;
                    file-related-repository-linked: file-related-repository-linked;
                    file-related-repository-open-requested => { file-related-repository-open-requested(); }
                    file-has-graphic: file-has-graphic;
                    file-graphic: file-graphic;
                    file-lines: file-lines;
                    file-text: file-text;
                    file-readme-name: file-readme-name;
                    file-readme-title: file-readme-title;
                    file-readme-excerpt: file-readme-excerpt;
                    file-readme-open-requested => { file-readme-open-requested(); }
                }
            }
            HorizontalLayout {
                height: 22px;
                padding-left: 4px;
                alignment: start;
                Text {
                    text: status-text;
                    color: Palette.foreground;
                    vertical-alignment: center;
                }
                if status-changed-label != "": StatusLink {
                    label: status-changed-label;
                    accessible-text: status-changed-accessible-label;
                    highlighted: status-link-focused;
                    activated => { status-changed-link-clicked(); }
                }
                if status-show-clear-link: Text {
                    text: " — ";
                    color: Palette.foreground;
                    vertical-alignment: center;
                }
                if status-show-clear-link: StatusLink {
                    label: "clear";
                    accessible-text: "clear the filter";
                    highlighted: status-link-focused;
                    activated => { status-clear-filter-clicked(); }
                }
            }
        }

        // The open menu's dropdown, and a full-window catcher behind it so a
        // click anywhere else closes the menu. Declared after the panes so
        // they draw over them.
        if open-menu >= 0: TouchArea {
            width: 100%;
            height: 100%;
            clicked => { open-menu = -1; }
        }

        if open-menu == 0: Rectangle {
            // Under the title it belongs to, rather than at a measured
            // offset: adding the Go menu moved every title to its right,
            // and hand-written offsets would have pointed at the wrong one
            // (#590's review).
            x: file-title.x;
            y: 24px * Zoom.factor;
            width: 210px * Zoom.factor;
            height: file-menu-items.preferred-height;
            background: Theme.panel;
            border-width: 1px;
            border-color: Theme.border;
            file-menu-items := VerticalLayout {
                ContextMenuItem {
                    label: "New Folder";
                    shortcut: "Ctrl+Shift+N";
                    item-height: menu-item-h;
                    activated => { open-menu = -1; new-folder-requested(); }
                }
                ContextMenuItem {
                    label: "New File";
                    shortcut: "Ctrl+N";
                    item-height: menu-item-h;
                    activated => { open-menu = -1; new-file-requested(); }
                }
                ContextMenuItem {
                    label: "Open";
                    // Open steps into a folder. On a file it did nothing
                    // at all, while looking exactly like a button that
                    // would.
                    item-enabled: can-open;
                    item-height: menu-item-h;
                    activated => { open-menu = -1; content-open-requested(); }
                }
                ContextMenuItem {
                    label: "Open on the web";
                    item-enabled: web-provider != "";
                    item-height: menu-item-h;
                    activated => { open-menu = -1; open-web-requested(); }
                }
                ContextMenuItem {
                    label: "Edit";
                    shortcut: "Ctrl+E";
                    item-enabled: can-edit;
                    item-height: menu-item-h;
                    activated => { open-menu = -1; edit-requested(); }
                }
                ContextMenuItem {
                    label: "Save";
                    shortcut: "Ctrl+S";
                    item-enabled: editing-file;
                    item-height: menu-item-h;
                    activated => { open-menu = -1; save-requested(); }
                }
                ContextMenuItem {
                    label: "Rename";
                    shortcut: "F2";
                    item-enabled: has-selection;
                    item-height: menu-item-h;
                    activated => { open-menu = -1; content-rename-requested(); }
                }
                ContextMenuItem {
                    label: "Delete";
                    shortcut: "Del";
                    item-enabled: has-selection;
                    item-height: menu-item-h;
                    activated => { open-menu = -1; delete-requested(); }
                }
                ContextMenuItem {
                    label: "Open terminal here";
                    item-enabled: can-open;
                    item-height: menu-item-h;
                    activated => { open-menu = -1; open-terminal-requested(); }
                }
                ContextMenuItem {
                    label: "Open in editor";
                    item-enabled: editor-available;
                    item-height: menu-item-h;
                    tooltip: "Set \"editor\" in the settings file, or install Visual Studio Code";
                    activated => { open-menu = -1; open-in-editor-requested(); }
                }
                ContextMenuItem {
                    label: "Copy path";
                    item-enabled: can-open;
                    item-height: menu-item-h;
                    activated => { open-menu = -1; copy-path-requested(); }
                }
                ContextMenuItem {
                    label: "Copy remote address";
                    item-enabled: content-remote-address-copyable;
                    item-height: menu-item-h;
                    activated => { open-menu = -1; copy-remote-address-requested(); }
                }
                ContextMenuItem {
                    label: file-manager-label;
                    item-enabled: can-open;
                    item-height: menu-item-h;
                    activated => { open-menu = -1; show-in-file-manager-requested(); }
                }
                ContextMenuItem {
                    label: "Repos Directory...";
                    item-height: menu-item-h;
                    activated => { open-menu = -1; repos-root-requested(); }
                }
                ContextMenuItem {
                    label: "Exit";
                    item-height: menu-item-h;
                    activated => { open-menu = -1; quit-requested(); }
                }
            }
        }

        if open-menu == 1: Rectangle {
            x: edit-title.x;
            y: 24px * Zoom.factor;
            width: 200px * Zoom.factor;
            height: edit-menu-items.preferred-height;
            background: Theme.panel;
            border-width: 1px;
            border-color: Theme.border;
            edit-menu-items := VerticalLayout {
                ContextMenuItem {
                    label: "Undo";
                    shortcut: "Ctrl+Z";
                    item-height: menu-item-h;
                    activated => { open-menu = -1; undo-requested(); }
                }
                ContextMenuItem {
                    label: "Cut";
                    shortcut: "Ctrl+X";
                    item-enabled: has-selection;
                    item-height: menu-item-h;
                    activated => { open-menu = -1; clipboard-cut-requested(); }
                }
                ContextMenuItem {
                    label: "Copy";
                    shortcut: "Ctrl+C";
                    item-enabled: has-selection;
                    item-height: menu-item-h;
                    activated => { open-menu = -1; clipboard-copy-requested(); }
                }
                ContextMenuItem {
                    label: "Paste";
                    shortcut: "Ctrl+V";
                    item-enabled: can-paste;
                    item-height: menu-item-h;
                    activated => { open-menu = -1; clipboard-paste-requested(); }
                }
                ContextMenuItem {
                    label: "Select All";
                    shortcut: "Ctrl+A";
                    item-height: menu-item-h;
                    activated => { open-menu = -1; select-all-requested(); }
                }
                ContextMenuItem {
                    label: "Find";
                    shortcut: "Ctrl+Shift+F";
                    item-height: menu-item-h;
                    activated => { open-menu = -1; find-requested(); }
                }
            }
        }

        if open-menu == 2: Rectangle {
            x: view-title.x;
            y: 24px * Zoom.factor;
            width: 210px * Zoom.factor;
            height: view-menu-items.preferred-height;
            background: Theme.panel;
            border-width: 1px;
            border-color: Theme.border;
            view-menu-items := VerticalLayout {
                ContextMenuItem {
                    label: "Refresh";
                    shortcut: "F5";
                    item-height: menu-item-h;
                    activated => { open-menu = -1; refresh-requested(); }
                }
                ContextMenuItem {
                    label: "All Repositories";
                    item-height: menu-item-h;
                    activated => { open-menu = -1; all-repositories-requested(); }
                }
                ContextMenuItem {
                    label: "Certificates";
                    item-height: menu-item-h;
                    activated => { open-menu = -1; certificates-requested(); }
                }
                ContextMenuItem {
                    label: "Up One Level";
                    shortcut: "Alt+Up";
                    item-height: menu-item-h;
                    activated => { open-menu = -1; parent-requested(); }
                }
                ContextMenuItem {
                    label: "Sort by Name";
                    item-height: menu-item-h;
                    activated => { open-menu = -1; content-sort-requested(0); }
                }
                ContextMenuItem {
                    label: "Sort by Size";
                    item-height: menu-item-h;
                    activated => { open-menu = -1; content-sort-requested(1); }
                }
                ContextMenuItem {
                    label: "Sort by Type";
                    item-height: menu-item-h;
                    activated => { open-menu = -1; content-sort-requested(2); }
                }
                ContextMenuItem {
                    label: "Sort by Modified";
                    item-height: menu-item-h;
                    activated => { open-menu = -1; content-sort-requested(3); }
                }
                ContextMenuItem {
                    label: "Zoom In";
                    shortcut: "Ctrl++";
                    item-height: menu-item-h;
                    activated => { open-menu = -1; zoom-in-requested(); }
                }
                ContextMenuItem {
                    label: "Zoom Out";
                    shortcut: "Ctrl+-";
                    item-height: menu-item-h;
                    activated => { open-menu = -1; zoom-out-requested(); }
                }
                ContextMenuItem {
                    label: "Actual Size";
                    shortcut: "Ctrl+0";
                    item-height: menu-item-h;
                    activated => { open-menu = -1; zoom-reset-requested(); }
                }
                // #617: pop a docked pane out into its own window, or dock
                // one that is already out back into this one.
                for row in pop-out-rows: ContextMenuItem {
                    label: "Pop Out " + row.label;
                    item-height: menu-item-h;
                    activated => { open-menu = -1; pop-out-requested(row.pane); }
                }
                for row in dock-rows: ContextMenuItem {
                    label: "Dock " + row.label;
                    item-height: menu-item-h;
                    activated => { open-menu = -1; dock-requested(row.pane); }
                }
                // #618: only meaningful from a popped-out window - the main
                // window's own View menu is only reachable while it is
                // already showing.
                if !is-main-window: ContextMenuItem {
                    label: "Show Main Window";
                    item-height: menu-item-h;
                    activated => { open-menu = -1; show-main-window-requested(); }
                }
            }
        }

        if open-menu == 3: Rectangle {
            x: go-title.x;
            y: 24px * Zoom.factor;
            width: 230px * Zoom.factor;
            height: go-menu-items.preferred-height;
            background: Theme.panel;
            border-width: 1px;
            border-color: Theme.border;
            go-menu-items := VerticalLayout {
                ContextMenuItem {
                    label: "Go to Repository...";
                    shortcut: "Ctrl+P";
                    item-height: menu-item-h;
                    activated => { open-menu = -1; switcher-open-requested(); }
                }
            }
        }

        if open-menu == 4: Rectangle {
            x: help-title.x;
            y: 24px * Zoom.factor;
            width: 200px * Zoom.factor;
            height: help-menu-items.preferred-height;
            background: Theme.panel;
            border-width: 1px;
            border-color: Theme.border;
            help-menu-items := VerticalLayout {
                ContextMenuItem {
                    label: "Keyboard Shortcuts";
                    shortcut: "F1";
                    item-height: menu-item-h;
                    activated => { open-menu = -1; shortcuts-open = true; }
                }
                ContextMenuItem {
                    label: "About RepoSphereExplorer";
                    item-height: menu-item-h;
                    activated => { open-menu = -1; about-requested(); }
                }
            }
        }

        // Help > Keyboard shortcuts (#585): every binding in one table,
        // grouped by the pane that answers it, so a reader can discover
        // what GUIDANCE.md §2.4 promises is there. An overlay Rectangle
        // rather than a `PopupWindow`, for the reason the dropdown menus
        // above are one too - see the comment by `open-menu`.
        if shortcuts-open: Rectangle {
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.35);

            TouchArea {
                width: 100%;
                height: 100%;
                clicked => { shortcuts-open = false; }
            }

            Rectangle {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: 480px;
                height: 420px;
                background: Theme.panel;
                border-width: 1px;
                border-color: Theme.border;

                // Swallows a press anywhere in the sheet, so clicking its
                // padding does not fall through to the backdrop behind it
                // and close the sheet the reader just opened.
                TouchArea {
                    width: 100%;
                    height: 100%;
                    clicked => { }
                }

                VerticalLayout {
                    padding: 12px;
                    spacing: 8px;

                    HorizontalLayout {
                        Text {
                            text: "Keyboard shortcuts";
                            font-weight: 700;
                            color: Palette.foreground;
                            horizontal-stretch: 1;
                            vertical-alignment: center;
                        }
                        Rectangle {
                            width: 64px;
                            height: 24px;
                            background: close-touch.has-hover ? Theme.hover : transparent;
                            border-width: 1px;
                            border-color: Theme.border;
                            accessible-role: button;
                            accessible-label: "Close";
                            Text {
                                text: "Close";
                                color: Palette.foreground;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                                width: 100%;
                                height: 100%;
                            }
                            close-touch := TouchArea {
                                width: 100%;
                                height: 100%;
                                clicked => { shortcuts-open = false; }
                            }
                        }
                    }

                    ScrollView {
                        VerticalLayout {
                            alignment: start;
                            spacing: 4px;
                            for row in shortcut-rows: VerticalLayout {
                                if row.group != "": Text {
                                    text: row.group;
                                    font-weight: 700;
                                    color: Theme.accent;
                                }
                                HorizontalLayout {
                                    spacing: 12px;
                                    Text {
                                        text: row.keys;
                                        color: Palette.foreground;
                                        width: 140px;
                                    }
                                    Text {
                                        text: row.description;
                                        color: Palette.foreground;
                                        horizontal-stretch: 1;
                                        wrap: word-wrap;
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        // Space's quick look (#721, GUIDANCE.md §2.3): a modest overlay
        // naming the selected entry, closed the same way it opened
        // (Space) or by Escape - the toggle itself is `App`'s
        // (`handle_key_text`/`quick_look_open`), this only shows what is
        // already open. An overlay `Rectangle` for the same reason the
        // shortcuts sheet above is one, rather than a `PopupWindow`.
        if quick-look-open: Rectangle {
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.55);

            TouchArea {
                width: 100%;
                height: 100%;
                clicked => { quick-look-close-requested(); }
            }

            Rectangle {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: 320px;
                height: 140px;
                background: Theme.panel;
                border-width: 1px;
                border-color: Theme.border;

                TouchArea {
                    width: 100%;
                    height: 100%;
                    clicked => { }
                }

                VerticalLayout {
                    padding: 16px;
                    spacing: 8px;
                    alignment: center;
                    Text {
                        text: quick-look-name;
                        color: Palette.foreground;
                        font-weight: 700;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                    }
                    Text {
                        text: "Space or Esc to close";
                        color: Theme.dim-text;
                        horizontal-alignment: center;
                    }
                }
            }
        }

        // Ctrl+P / Cmd+P's Go to Repository switcher (#590): a small
        // overlay near the top of the window, rather than the shortcuts
        // sheet's centred one above - a reader jumping to a repository is
        // still watching the panes settle, where a sheet covering them
        // would hide the very thing that confirms it worked.
        if switcher-open: Rectangle {
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.35);

            TouchArea {
                width: 100%;
                height: 100%;
                clicked => { cancel-requested(); }
            }

            Rectangle {
                x: (parent.width - self.width) / 2;
                y: 64px;
                width: 480px;
                height: 300px;
                background: Theme.panel;
                border-width: 1px;
                border-color: Theme.accent;

                // Swallows a press anywhere in the switcher, so clicking
                // its padding does not fall through to the backdrop and
                // close it.
                TouchArea {
                    width: 100%;
                    height: 100%;
                    clicked => { }
                }

                VerticalLayout {
                    padding: 8px;
                    spacing: 6px;

                    Rectangle {
                        height: 24px;
                        background: Theme.field;
                        border-width: 1px;
                        border-color: Theme.accent;
                        HorizontalLayout {
                            padding-left: 6px;
                            padding-right: 6px;
                            Text {
                                text: switcher-query == "" ? "Go to repository" : switcher-query;
                                color: switcher-query == "" ? Theme.dim-text : Palette.foreground;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                                accessible-role: text;
                                accessible-label: "Go to repository";
                            }
                        }
                    }

                    ScrollView {
                        VerticalLayout {
                            alignment: start;
                            for row[index] in switcher-rows: Rectangle {
                                height: 22px;
                                background: row.selected ? Theme.accent : transparent;
                                HorizontalLayout {
                                    padding-left: 4px;
                                    padding-right: 4px;
                                    spacing: 6px;
                                    Text {
                                        text: row.name;
                                        color: row.selected ? Palette.background : Palette.foreground;
                                        vertical-alignment: center;
                                        horizontal-stretch: 1;
                                        overflow: elide;
                                    }
                                    if row.path != "": Text {
                                        text: row.path;
                                        color: row.selected ? Palette.background : Theme.dim-text;
                                        vertical-alignment: center;
                                    }
                                    Text {
                                        text: row.branch;
                                        color: row.selected ? Palette.background : Theme.dim-text;
                                        vertical-alignment: center;
                                    }
                                    Text {
                                        text: row.marker;
                                        color: row.marker-warning ? Theme.warning : (row.selected ? Palette.background : Theme.dim-text);
                                        vertical-alignment: center;
                                        accessible-label: row.marker-tooltip;
                                    }
                                }
                                TouchArea {
                                    width: 100%;
                                    height: 100%;
                                    clicked => { switcher-row-clicked(index); }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
