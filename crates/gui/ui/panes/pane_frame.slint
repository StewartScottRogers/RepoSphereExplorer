import { Palette } from "std-widgets.slint";
import { Theme } from "../theme.slint";

// The frame every pane sits in: the border that says which pane holds the
// keyboard, and the title above whatever the pane itself draws. The three
// panes' own headers used to repeat this; now they inherit it.
export component PaneFrame inherits Rectangle {
    in property <string> title;
    in property <bool> focused;
    // The tool slot's picker (#616): every tool that applies to the
    // current selection, in the order it offers them. Left empty by every
    // pane but the slot, and by the slot itself whenever one tool or none
    // applies - which is when the title below draws exactly as it always
    // did, with nothing to choose among.
    //
    // The choice among tools lives on the title itself rather than in a
    // second tab strip: the File pane already has one, for a file's own
    // views (#564), and stacking a second strip above it for this read as
    // clutter rather than as two different questions.
    in property <[string]> tool-titles;
    in property <int> tool-index;
    callback tool-selected(int);
    property <bool> picker-open: false;
    // Whether this pane is showing in a window of its own (#617): the
    // frame draws a dock button in place of the pop-out one, and titles
    // the button the other way round.
    in property <bool> popped-out: false;
    callback pop-out-clicked();
    callback dock-clicked();
    // The pin button (#619): only the tool slot's own popped-out window
    // offers it - Folders and Contents windows have no pin, since they
    // are the selection - so this is left false by every other pane.
    in property <bool> pinnable: false;
    in property <bool> pinned: false;
    callback pin-clicked();
    callback unpin-clicked();

    border-width: 1px;
    border-color: focused ? Theme.accent : Theme.border;

    VerticalLayout {
        title-row := Rectangle {
            height: 22px;
            Text {
                text: title;
                font-weight: 700;
                // The border and the selection say which pane is focused;
                // the title does not turn blue as well (#575).
                color: Theme.heading-text;
                width: 100%;
                height: 100%;
                horizontal-alignment: center;
            }
            if tool-titles.length > 1: TouchArea {
                width: 100%;
                height: 100%;
                mouse-cursor: pointer;
                clicked => { picker-open = !picker-open; }
            }
            // #617: pops this pane out into a window of its own, or - once
            // it is out - docks it back.
            pop-out-slot := HorizontalLayout {
                x: parent.width - self.width;
                alignment: end;
                padding-right: 4px;
                spacing: 2px;
                // #619: pins this window to what it is showing, so it
                // keeps that rather than following the shared selection -
                // only offered once the pane is already popped out, and
                // only by the pane this frame belongs to when it is the
                // tool slot (`pinnable`); Folders and Contents have no pin,
                // since they are the selection.
                if popped-out && pinnable: Rectangle {
                    width: 18px;
                    height: 18px;
                    background: pin-touch.has-hover ? Theme.hover : transparent;
                    border-radius: 3px;
                    accessible-role: button;
                    accessible-label: pinned ? "Unpin" : "Pin: keep showing this";
                    Text {
                        // A filled pin when pinned, an outline when not.
                        text: pinned ? "\u{1F4CC}" : "\u{1F4CD}";
                        width: 100%;
                        height: 100%;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        color: Theme.dim-text;
                    }
                    pin-touch := TouchArea {
                        width: 100%;
                        height: 100%;
                        mouse-cursor: pointer;
                        clicked => {
                            if (pinned) {
                                unpin-clicked();
                            } else {
                                pin-clicked();
                            }
                        }
                    }
                    if pin-touch.has-hover: Rectangle {
                        x: -pin-tip-text.preferred-width - 12px;
                        y: 0px;
                        width: pin-tip-text.preferred-width + 8px;
                        height: pin-tip-text.preferred-height + 6px;
                        background: Theme.panel;
                        border-width: 1px;
                        border-color: Theme.border;
                        pin-tip-text := Text {
                            x: 4px;
                            y: 3px;
                            text: pinned ? "Unpin" : "Keep showing this";
                            color: Palette.foreground;
                        }
                    }
                }
                Rectangle {
                    width: 18px;
                    height: 18px;
                    background: pop-out-touch.has-hover ? Theme.hover : transparent;
                    border-radius: 3px;
                    accessible-role: button;
                    accessible-label: popped-out ? "Dock into the main window" : "Pop out into its own window";
                    Text {
                        // U+2197 (north-east arrow) to pop out, U+2199
                        // (south-west arrow) to dock back.
                        text: popped-out ? "\u{2199}" : "\u{2197}";
                        width: 100%;
                        height: 100%;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        color: Theme.dim-text;
                    }
                    pop-out-touch := TouchArea {
                        width: 100%;
                        height: 100%;
                        mouse-cursor: pointer;
                        clicked => {
                            if (popped-out) {
                                dock-clicked();
                            } else {
                                pop-out-clicked();
                            }
                        }
                    }
                    // The same tooltip shape `ContextMenuItem` draws for a
                    // disabled item's reason, reused here for a plain
                    // hover hint since this button carries no label of
                    // its own.
                    if pop-out-touch.has-hover: Rectangle {
                        x: -tip-text.preferred-width - 12px;
                        y: 0px;
                        width: tip-text.preferred-width + 8px;
                        height: tip-text.preferred-height + 6px;
                        background: Theme.panel;
                        border-width: 1px;
                        border-color: Theme.border;
                        tip-text := Text {
                            x: 4px;
                            y: 3px;
                            text: popped-out ? "Dock into the main window" : "Pop out into its own window";
                            color: Palette.foreground;
                        }
                    }
                }
            }
        }
        @children
    }

    if picker-open: Rectangle {
        x: 0;
        y: 22px;
        width: 160px;
        background: Theme.panel;
        border-width: 1px;
        border-color: Theme.border;
        VerticalLayout {
            for name[i] in tool-titles: Rectangle {
                height: 22px;
                background: i == tool-index ? Theme.hover : transparent;
                Text {
                    text: name;
                    width: 100%;
                    height: 100%;
                    vertical-alignment: center;
                    horizontal-alignment: center;
                    color: Palette.foreground;
                }
                TouchArea {
                    width: 100%;
                    height: 100%;
                    mouse-cursor: pointer;
                    clicked => {
                        tool-selected(i);
                        picker-open = false;
                    }
                }
            }
        }
    }
}
