# A repository's own configuration, carrying two remotes with a separate
# push address, three tracking branches, an identity, aliases, an include
# and a conditional include.

[core]
	repositoryformatversion = 0
	filemode = false
	bare = false
	logallrefupdates = true
	ignorecase = true

[user]
	name = Example Engineering
	email = engineering@example.com

[remote "origin"]
	url = https://github.com/example/repo-sphere.git
	pushurl = git@github.com:example/repo-sphere.git
	fetch = +refs/heads/*:refs/remotes/origin/*

[remote "upstream"]
	url = https://github.com/upstream/repo-sphere.git
	fetch = +refs/heads/*:refs/remotes/upstream/*

[branch "main"]
	remote = origin
	merge = refs/heads/main

[branch "release"]
	remote = origin
	merge = refs/heads/release

[branch "spike"]
	remote = upstream
	merge = refs/heads/spike

[alias]
	lg = log --oneline --graph --decorate
	st = status --short --branch
	undo = reset --soft HEAD~1

[push]
	default = simple
	autoSetupRemote = true

[include]
	path = ../shared/.gitconfig-common

[includeIf "gitdir:~/work/"]
	path = ~/.gitconfig-work
