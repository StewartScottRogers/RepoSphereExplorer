{
  "name": "example/router",
  "description": "A small PSR-15 style HTTP router with middleware.",
  "type": "library",
  "license": "MIT",
  "keywords": ["router", "http", "middleware", "psr-15"],
  "homepage": "https://github.com/example/router",
  "require": {
    "php": ">=8.3"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5",
    "friendsofphp/php-cs-fixer": "^3.75",
    "phpstan/phpstan": "^2.1"
  },
  "autoload": {
    "psr-4": {
      "App\\Http\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "App\\Http\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "lint": "php-cs-fixer fix --dry-run --diff",
    "analyse": "phpstan analyse src tests --level 8"
  },
  "config": {
    "sort-packages": true
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
