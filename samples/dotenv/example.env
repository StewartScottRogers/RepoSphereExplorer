# An example environment file. Every value here is a placeholder: the real
# one is ignored, and this exists so somebody knows which names to set.

APP_NAME=repo-sphere
RUST_LOG=info,service=debug

# Quoted, because the value carries characters a shell would otherwise eat.
DATABASE_URL="postgres://app:app@localhost:5432/app?sslmode=disable"

# Interpolated from the one above it.
MIGRATION_URL=${DATABASE_URL}&application_name=migrate

# Exported, which some loaders honour and some ignore.
export CARGO_TERM_COLOR=always

# A value that runs across lines, which the reader has to follow.
BANNER_TEXT="Repos Explorer
a front door to your development workspace"

# Named like credentials. The plugin says so; it never reads what they hold.
API_TOKEN=replace-me
DB_PASSWORD=replace-me
SIGNING_PRIVATE_KEY=replace-me
