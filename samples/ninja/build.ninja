# Generated by a build system, and read by nobody who enjoys it.

ninja_required_version = 1.11

builddir = out
cxx = clang++
cxxflags = -std=c++20 -O2 -Wall -Iinclude
ldflags = -lpthread
ar = llvm-ar

include rules/toolchain.ninja
subninja tools/build.ninja

rule cxx_compile
  command = $cxx -MMD -MF $out.d $cxxflags -c $in -o $out
  depfile = $out.d
  deps = gcc
  description = CXX $out

rule cxx_link
  command = $cxx $in -o $out $ldflags
  description = LINK $out

rule archive
  command = $ar rcs $out $in
  description = AR $out

rule generate_readings
  command = python3 tools/generate.py --rows $rows --out $out
  description = GEN $out
  restat = 1

build $builddir/column.o: cxx_compile src/column.cc
build $builddir/reader.o: cxx_compile src/reader.cc
build $builddir/summary.o: cxx_compile src/summary.cc
build $builddir/main.o: cxx_compile src/main.cc

build $builddir/libcsvstats.a: archive $builddir/column.o $builddir/reader.o $builddir/summary.o

build $builddir/csvstats: cxx_link $builddir/main.o $builddir/libcsvstats.a

build $builddir/readings.csv: generate_readings
  rows = 200

build test: phony $builddir/csvstats $builddir/readings.csv
build all: phony $builddir/csvstats

default all
