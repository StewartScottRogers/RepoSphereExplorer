--  Generated by Alire, and checked in so a build without Alire still
--  resolves. Regenerate with `alr build` rather than editing by hand.

abstract project Stack_Demo_Config is
   Crate_Version := "1.0.0";
   Crate_Name := "stack_demo";

   Build_Profile := external ("STACK_DEMO_BUILD_PROFILE", "development");

   Ada_Compiler_Switches := ();
   case Build_Profile is
      when "release" =>
         Ada_Compiler_Switches := ("-O3", "-gnatn");
      when others =>
         Ada_Compiler_Switches := ("-O0", "-g", "-gnatVa");
   end case;
end Stack_Demo_Config;
