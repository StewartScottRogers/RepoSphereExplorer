with "config/stack_demo_config.gpr";

project Stack_Demo is

   for Source_Dirs use ("src", "config");
   for Object_Dir use "obj/" & Stack_Demo_Config.Build_Profile;
   for Exec_Dir use "bin";
   for Main use ("stack_demo.adb");

   package Compiler is
      for Default_Switches ("Ada") use
        Stack_Demo_Config.Ada_Compiler_Switches &
        ("-gnatwa",      --  every warning
         "-gnatwe",      --  and every warning is an error
         "-gnata",       --  assertions and contracts on
         "-gnaty4aAbcefhiklnprStux");  --  style checks
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es");  --  symbolic tracebacks
   end Binder;

end Stack_Demo;
