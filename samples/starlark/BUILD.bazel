load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_test")
load("@rules_python//python:defs.bzl", "py_binary")
load("//tools:readings.bzl", "readings_fixture")

package(default_visibility = ["//visibility:private"])

cc_library(
    name = "column",
    srcs = glob(["src/column/*.cc"]),
    hdrs = glob(
        ["include/csvstats/*.h"],
        exclude = ["include/csvstats/internal_*.h"],
    ),
    copts = [
        "-std=c++20",
        "-Wall",
    ],
    includes = ["include"],
    visibility = ["//visibility:public"],
    deps = [
        "@abseil-cpp//absl/status",
        "@abseil-cpp//absl/strings",
    ],
)

cc_binary(
    name = "csvstats",
    srcs = ["src/main.cc"],
    visibility = ["//visibility:public"],
    deps = [
        ":column",
        "@abseil-cpp//absl/flags:parse",
    ],
)

cc_test(
    name = "column_test",
    size = "small",
    srcs = glob(["test/*_test.cc"]),
    data = [":sample_readings"],
    deps = [
        ":column",
        "@googletest//:gtest_main",
    ],
)

py_binary(
    name = "summarise",
    srcs = ["tools/summarise.py"],
    main = "tools/summarise.py",
    visibility = ["//visibility:public"],
    deps = ["@rules_python//python/runfiles"],
)

readings_fixture(
    name = "sample_readings",
    rows = 200,
    seed = 17,
)

filegroup(
    name = "docs",
    srcs = glob(["docs/**/*.md"]),
    visibility = ["//docs:__pkg__"],
)
